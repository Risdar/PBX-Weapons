// Tesla Gun
$random TESLAH {TESLAH1 TESLAH2 TESLAH3 TESLAH4}
TESLAH1 TESLAH1 
TESLAH2 TESLAH2 
TESLAH3 TESLAH3 
TESLAH4 TESLAH4 

LIGHTNG1 LIGHTNG1
LIGHTNG2 LIGHTNG2
LIGHTNG3 LIGHTNG3
LIGHTNG4 LIGHTNG4
$random LIGHTNG {LIGHTNG1 LIGHTNG2 LIGHTNG3}

$volume electrogun/bomb 4
$rolloff electrogun/explode 1400 3200
electrogun/pickup       PZAPPICK
electrogun/shoot		PZAPSEE	
electrogun/fire 		PZAPFIRE
electrogun/loop         PZAPLOOP
electrogun/hit			PZAPHIT
electrogun/charge		PZAPCHRG	
electrogun/cooloff      PZAPRMBL
electrogun/charge2		PZAPCHR2
electrogun/bomb         PZAPBOMB
electrogun/explode      PZAPBEXP
electrogun/hum          PZAPHUM
electrogun/select       PZAPSEL

// Freeze Rifle
coldcst "sounds/Weapons/Slot-8/FreezeRifle/coldcast.wav"
iceimpa "sounds/Weapons/Slot-8/FreezeRifle/iceimpact3.wav"

FRZFIRE2 FRZFIRE2
$rolloff FRZFIRE2 1000 7500

cryodea1 "Sounds/Weapons/Slot-8/FreezeRifle/FZR_MISSILEDEATH1.ogg"
$rolloff cryodea1 600 2000
cryodea3 "Sounds/Weapons/Slot-8/FreezeRifle/FZR_MISSILEDEATH3.ogg"
$rolloff cryodea3 600 2000
cryodea4 "Sounds/Weapons/Slot-8/FreezeRifle/FZR_MISSILEDEATH4.ogg"
$rolloff cryodea4 600 2000
icespik "sounds/Weapons/Slot-8/FreezeRifle/icespike3.wav"

$random DSBOTTLE {DSBOTTLE1 DSBOTTLE2 DSBOTTLE3}
DSBOTTLE1 "Sounds/Weapons/Slot-8/FreezeRifle/DSBOTTLE.mp3"
$pitchset 	DSBOTTLE1 1.0
DSBOTTLE2 "Sounds/Weapons/Slot-8/FreezeRifle/DSBOTTLE.mp3"
$pitchset 	DSBOTTLE2 1.2
DSBOTTLE3 "Sounds/Weapons/Slot-8/FreezeRifle/DSBOTTLE.mp3"
$pitchset 	DSBOTTLE3 1.3