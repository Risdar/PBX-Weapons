[enu default]

//////////////////////////// SLOT 1 ///////////////////////////////////////////////////////////////////////////////

//////////////////////////// SLOT 2 ///////////////////////////////////////////////////////////////////////////////
// Lever Action
PBX_LeverActionUpgrade_Tip1 = "You just unlocked the .444 Marlin ammo.";
PBX_LeverActionUpgrade_Tip2 = "The .444 Marlin deals increased damage but takes %d low caliber ammo and halves your magazine capacity to %d.";

//////////////////////////// SLOT 3 ///////////////////////////////////////////////////////////////////////////////
// CSSG 
PBX_CSSG_Tip1 = "You can switch between the Meat Hook Secondary or Single Fire Secondary using %s.";

PBX_CSSGUpgrade_Tip1 = "You just picked up one of the many CSSG Upgrades.";
PBX_CSSGUpgrade_Tip2 = "Gotta catch 'em all.";

// PSG
PBX_PSG_Tip1 = "You can switch between various equipments using %s.";
PBX_PSG_Tip2 = "You can manually detonate the equipments and see how much rocket ammo each one uses from the wheel.";
PBX_PSG_Tip3 = "You can recover any thrown equipment by coming near and pressing %s.";

//////////////////////////// SLOT 4 ///////////////////////////////////////////////////////////////////////////////

// Metal Sniper
PBX_MetalSniper_Tip1 = "You can switch Secondary modes using %s.";
PBX_MetalSniper_Tip2 = "The Grenade AltFire needs to be primed before firing by pressing %s and then %s";
PBX_MetalSniper_Tip3 = "Opening the Weapon Special Wheel when \cdzoomed \c-in will let you select the Advanced Targeting Scope Modes.";

PBX_MetalSniperUpgrade_Tip1 = "The Resonance Ammo is a special Anti Arachno-Shield round.";
PBX_MetalSniperUpgrade_Tip2 = "Shooting it at an Arachnotron shield will ignite the shield and stun all nearby enemies.";
PBX_MetalSniperUpgrade_Tip3 = "Every shot has a high chance to stun the target.";

// Crossbow Ballista 
PBX_DemonicBallista_Tip1 = "You just picked up the Demonic Ballista.";
PBX_DemonicBallista_Tip2 = "Every shot will now deal fire damage and the Altfire shoots a flaming razorblade";

//////////////////////////// SLOT 5 ///////////////////////////////////////////////////////////////////////////////
// HMG
PBX_NeoHMG_Tip1 = "The HMG has a shield that can be activated using %s and only recharges when there's overheat.";
PBX_NeoHMG_Tip2 = "Pressing the %s key while the shield is active will detonate the shield stunning nearby enemies.";
PBX_NeoHMG_Tip3 = "When overheat reaches %d° C the weapon will fire a stronger bullet and recharge the shield faster.";

// Super Nailgun
PBX_SuperNailgun_Tip1 = "When the Super Nailgun overheat at %d° C it will fire special nails depending on the current mode.";
PBX_SuperNailgun_Tip2 = "Super Heated Nails will bounce and burn while Super Charged Nails will electrocute nearby enemies.";
PBX_SuperNailgun_Tip3 = "Pressing %s will spin the weapon passively increasing the overheat.";

//////////////////////////// SLOT 6 ///////////////////////////////////////////////////////////////////////////////
// Excavator
PBX_Excavator_Tip1 = "The Excavator has two modes and can be manually detonated with %s";
PBX_Excavator_Tip2 = "Drill mode rocket will burrow into the ground and come to the surface upon detonation.";
PBX_Excavator_Tip3 = "Drop mode rocket will fly normally and drop into the ground upon detonation.";

PBX_ExcavatorUpgrade_Tip1 = "The Excavator Upgrade adds 2 new modes.";
PBX_ExcavatorUpgrade_Tip2 = "The Explosive Bolas will launch sticky bolas to enemies that detonates after a while and the AltFire will shoot 6 burst of Sticky Grenades.";
PBX_ExcavatorUpgrade_Tip3 = "The Razorblade mode will launch a Razorblade that sticks to enemies and the AltFire will charge fire bouncing Razorblade.";

// Paingiver
PBX_Paingiver_Tip1 = "The Paingiver Primary shoots normal Rockets while its Secondary fires three bursts of seeking rockets.";
PBX_Paingiver_Tip2 = "The Paingiver Enraged State will make the Paingiver not take any ammo when shooting, gives 75 Percent damage reduction, and increased fire rate.";

//////////////////////////// SLOT 7 ///////////////////////////////////////////////////////////////////////////////
PBX_BDPRailgun_Tip1 = "The Platinum Railgun has a hologram that can be activated using %s.";
PBX_BDPRailgun_Tip2 = "Pressing %s when \cdZoomed \c-in will let you select the Scoped Modes";

//////////////////////////// SLOT 8 ///////////////////////////////////////////////////////////////////////////////
PBX_Teslagun_Tip1 = "The Tesla Gun Primary fires a constant arc of electricity, while the altfire fires a lightning ball.";
PBX_Teslagun_Tip2 = "The Lightning ball will bounce on walls and can be charged using the primary fire.";
PBX_Teslagun_Tip3 = "When charged the lightning ball will zap nearby enemies and with full charge it will summon lightning to everything near it.";
PBX_Teslagun_Tip4 = "The weapon holds lightning charges that increase when firing and can be activated using %s.";

//////////////////////////// SLOT 9 ///////////////////////////////////////////////////////////////////////////////
// Demonic Exterminator
PBX_DemonExt_Tip1 = "By killing enemies with the Demonic Exterminator, you will earn souls.";
PBX_DemonExt_Tip2 = "You can use the souls when in \cjSoul Lightning \c-Mode.";

//////////////////////////// OTHERS ///////////////////////////////////////////////////////////////////////////////
// SHARED
PBX_DisableUpgrade      = "You can bypass this requirement by disabling the upgrade in the Addon Spawner Settings.";

PBX_ScrollZoom_Tip1     = "You just picked up a scoped weapon";
PBX_ScrollZoom_Tip2     = "Every scoped weapon has variable zoom that can be adjusted using the \cnScroll Wheel\c- when \cdZoomed \c-in";
PBX_ScrollZoom_Tip3     = "You can also manually adjust the zoom using %s to Zoom In or %s to Zoom Out";

PBX_MonsterWeapon1      = "You have picked up a Monster Weapon, they are very powerful weapons but has durability.";
PBX_MonsterWeapon2      = "You can restore its durability by picking up the same weapon again.";

PBX_DemonicWeapon1      = "You have picked up a Demonic Weapon, every demonic weapon has an enraged state.";
PBX_DemonicWeapon2      = "Enraged State requires Soul Charges to activate, this can only be replenished using the Demonic Exterminator.";

PBX_CommanderWeapon1    = "You have picked up a Commander Weapon, they work like normal weapons but has various special abilities.";
PBX_CommanderWeapon2    = "Every weapon in this category can use different types of equipment or ammo types.";



