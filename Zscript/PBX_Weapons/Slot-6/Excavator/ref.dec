// --------------------------------------------------------------------------
//
// Grenade Launcher
//
// --------------------------------------------------------------------------
Actor SawBladeMode : Inventory
{Inventory.MaxAmount 1}
Actor RespectExcavator : Inventory
{Inventory.MaxAmount 1}
Actor ExcavatorUnloaded: Inventory
{inventory.maxamount 4 }

ACTOR ExcavatorAmmo : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 6
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 6
   Inventory.Icon "TNT1A0"
}

ACTOR Excavator : PB_Weapon
{
	SpawnID 9530
	Weapon.BobRangeX 0.3
	Weapon.BobRangeY 0.5
	Weapon.BobStyle InverseSmooth
	Weapon.BobSpeed 2.4
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive1 8
	Weapon.AmmoGive2 8
	Weapon.AmmoType1 "ExplosiveAmmo"
	Weapon.AmmoType2 "ExcavatorAmmo"
	+FLOORCLIP
	+DONTGIB
    Inventory.PickupSound "misc/ROCKBOXA"
    +WEAPON.NOAUTOAIM
	+WEAPON.EXPLOSIVE
	+WEAPON.NOAUTOFIRE
	Tag "Excavator"
	Scale .49
	Inventory.PickupMessage "Excavator (Slot 5)"
	Obituary "%k Demolished %o with an Excavator"
	States {
	
		Steady:
			TNT1 A 1
			Goto Ready
	
		Ready:
			TNT1 A 0
			TNT1 A 0 A_ZoomFactor(1.0)
			TNT1 A 0 A_JumpIfInventory("RespectExcavator", 1, "SelectAnimation")
		Respect:
			TNT1 A 0
			TNT1 A 0 A_GiveInventory("RespectExcavator",1)
			TNT1 A 0 A_PlaySound("RLANDRAW")
			TNT1 A 5
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"RespectSaw")
			EX_L QRSTUVW 1 {
				A_SetRoll(roll-0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_G NNN 1 A_DoPBWeaponAction
			EX_I HHHHGFE 1 {
				A_SetRoll(roll+0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_PlaySound("RLCYCLE2", 13)
			EX_I DDDDDCBA 1 A_DoPBWeaponAction
			EX_E NNN 1 A_DoPBWeaponAction 
			TNT1 A 0 A_PlaySound("weapons/minigun/respect1", 13)
			EX_E OPQRST 1 {
				A_SetRoll(roll-0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_E UVWX 1 A_DoPBWeaponAction
			EX_E YZ 1 {
				A_SetRoll(roll+0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_F ABCC 1 {
				A_SetRoll(roll+0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_F CCC 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaySound("excavator_magslap", 13)
			EX_F EFGHIJ 1 {
				A_SetRoll(roll+0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_F JIHGFL 1 {
				A_SetRoll(roll-0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_PlaySound("weapons/nailgun/up", 10)
			EX_F MNO 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaySound("excavator/detonate")
			EX_A EEEEE 1 A_DoPBWeaponAction
			TNT1 A 0 A_Takeinventory("PB_LockScreenTilt",1)
			Goto Ready3
			
		RespectSaw:
			EX_K QRSTUVW 1 {
				A_SetRoll(roll-0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_E NNN 1 A_DoPBWeaponAction
			EX_I ABCDDDD 1 {
				A_SetRoll(roll+0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_PlaySound("RLCYCLE2", 13)
			EX_I EFGHHHHH 1 A_DoPBWeaponAction
			EX_G NNN 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaySound("weapons/minigun/respect1", 13)
			EX_G OPQRST 1 {
				A_SetRoll(roll-0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_G UVWX 1 A_DoPBWeaponAction
			EX_G YZ 1 {
				A_SetRoll(roll+0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_H ABCC 1 {
				A_SetRoll(roll+0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_H CCC 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaySound("excavator_magslap", 13)
			EX_H EFGHIJ 1 {
				A_SetRoll(roll+0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			EX_H JIHGFL 1 {
				A_SetRoll(roll-0.6,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_PlaySound("weapons/nailgun/up", 10)
			EX_H MNO 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaySound("excavator/detonate")
			EX_C EEEEE 1 A_DoPBWeaponAction
			TNT1 A 0 A_Takeinventory("PB_LockScreenTilt",1)
			Goto Ready3
			
		SelectAnimation:
			TNT1 A 0 A_PlaySound("RLANDRAW")
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"SelectAnimationSaw")
		SelectAnimationBola:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"SelectAnimationBolaUnloaded")
			EX_A ABCDE 1
			Goto Ready3
		SelectAnimationBolaUnloaded:
			EX_B ABCDE 1
			Goto Ready3
		SelectAnimationSaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"SelectAnimationSawUnloaded")
			EX_C ABCDE 1
			Goto Ready3
		SelectAnimationSawUnloaded:
			EX_D ABCDE 1
			Goto Ready3
		
		Ready3:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
			TNT1 A 0 A_SetCrosshair(78)
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"ReadySaw")
		ReadyBola:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"ReadyBolaUnloaded")
			EX_A E 1 A_DoPBWeaponAction
			Loop
		ReadyBolaUnloaded:
			EX_B E 1 A_DoPBWeaponAction
			Loop
		ReadySaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"ReadySawUnloaded")
			EX_C E 1 A_DoPBWeaponAction
			Loop
		ReadySawUnloaded:
			EX_D E 1 A_DoPBWeaponAction
			Loop
			
		WeaponSpecial:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "WeaponSpecialObject")
			TNT1 A 0 {
				A_TakeInventory("GoWeaponSpecialAbility", 1);
				A_Giveinventory("PB_LockScreenTilt",1);
				A_ZoomFactor(1.0);
				}
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"Ready3")
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"WeaponSpecialSaw")
			TNT1 A 0 A_PlaySound("Ironsights", 15)
			EX_E ABCD 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_E EEE 1
			EX_E FGHI 1 A_SetRoll(roll+1.2,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/sgl/cycle", 14)
			EX_E JKLM 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_E NNN 1 
			Goto RemoveBulletsWeaponSpecial
		WeaponSpecial2:
			EX_I ABCDDDDD 1 
			TNT1 A 0 A_PlaySound("RLCYCLE2", 13)
			EX_I EFGHHHHH 1
			EX_G NNN 1 
			TNT1 A 0 A_PlaySound("weapons/minigun/respect1", 13)
			EX_G OPQRST 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_G UVWX 1 
			EX_G YZ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_H ABCC 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_H CCC 1
			Goto InsertBulletsWeaponSpecial
		WeaponSpecial3:
			TNT1 A 0 {
				A_GiveInventory("SawBladeMode",1);
				A_GiveInventory("HitboxBladedDamage",1);
				A_PlaySound("excavator_magslap", 13);
			}
			EX_H EFGHIJ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_H JIHGFL 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/nailgun/up", 10)
			EX_H MNO 1
			TNT1 A 0 A_PlaySound("excavator/detonate")
			EX_C EEEEE 1
			TNT1 A 0 {
				A_Takeinventory("PB_LockScreenTilt",1);
			}
			Goto Ready3
		
		RemoveBulletsWeaponSpecial:
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",1,1)
			Goto WeaponSpecial2
			TNT1 A 0 
			{
				A_Takeinventory("ExcavatorAmmo",1);
				A_Giveinventory("ExplosiveAmmo",1);
			}
			Goto RemoveBulletsWeaponSpecial
		InsertBulletsWeaponSpecial:
			TNT1 A 0 A_JumpIfInventory("FuelAmmo",5,1)
			Goto WeaponSpecial3
			TNT1 A 0 A_Giveinventory("ExcavatorAmmo",1)
			TNT1 A 0 A_Takeinventory("FuelAmmo",5)
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",6,"WeaponSpecial3")
			Loop
			
		WeaponSpecialSaw:
			TNT1 A 0 A_PlaySound("Ironsights", 15)
			EX_G ABCD 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_G EEE 1
			EX_G FGHI 1 A_SetRoll(roll+1.2,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/sgl/cycle", 14)
			EX_G JKLM 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_G NNN 1 
			Goto RemoveBulletsWeaponSpecialSaw
		WeaponSpecialSaw2:
			EX_I HHHHHGFE 1 
			TNT1 A 0 A_PlaySound("RLCYCLE2", 13)
			EX_I DDDDDCBA 1
			EX_E NNN 1 
			TNT1 A 0 A_PlaySound("weapons/minigun/respect1", 13)
			EX_E OPQRST 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_E UVWX 1 
			EX_E YZ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_F ABCC 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_F CCC 1
			Goto InsertBulletsWeaponSpecialSaw
		WeaponSpecialSaw3:
			TNT1 A 0 {
				A_TakeInventory("SawBladeMode",1);
				A_TakeInventory("HitboxBladedDamage",1);
				A_PlaySound("excavator_magslap", 13);
			}
			EX_F EFGHIJ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_F JIHGFL 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/nailgun/up", 10)
			EX_F MNO 1
			TNT1 A 0 A_PlaySound("excavator/detonate")
			EX_A EEEEE 1
			TNT1 A 0 {
				A_Takeinventory("PB_LockScreenTilt",1);
			}
			Goto Ready3
			
		RemoveBulletsWeaponSpecialSaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",1,1)
			Goto WeaponSpecialSaw2
			TNT1 A 0 
			{
				A_Takeinventory("ExcavatorAmmo",1);
				A_Giveinventory("FuelAmmo",5);
			}
			Goto RemoveBulletsWeaponSpecialSaw
		InsertBulletsWeaponSpecialSaw:
			TNT1 A 0 A_JumpIfInventory("ExplosiveAmmo",1,1)
			Goto WeaponSpecialSaw3
			TNT1 A 0 A_Giveinventory("ExcavatorAmmo",1)
			TNT1 A 0 A_Takeinventory("ExplosiveAmmo",1)
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",6,"WeaponSpecialSaw3")
			Loop
		
		Deselect:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "DeselectObject")
			TNT1 A 0 A_PlaySound("weapons/changing", 1)
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"DeselectSaw")
		DeselectBola:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"DeselectBolaUnloaded")
			EX_A EDCBA 1
			Goto FinishDeselect
		DeselectBolaUnloaded:
			EX_B EDCBA 1
			Goto FinishDeselect
		DeselectSaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"DeselectSawUnloaded")
			EX_C EDCBA 1
			Goto FinishDeselect
		DeselectSawUnloaded:
			EX_D EDCBA 1
			Goto FinishDeselect
		FinishDeselect:
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
			Wait

		Select:
			TNT1 A 0 {
					A_SetCrosshair(78);
					A_SetRoll(0);
				}
				TNT1 A 0 A_Overlay(-10, "FirstPersonLegsStand")
				TNT1 A 0 A_Takeinventory("RandomHeadExploder",1)
				TNT1 A 0 A_Takeinventory("HitboxFireDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxIceDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxAcidDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxPlasmaDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxDemonicDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxBladedDamage",1)
				TNT1 A 0 A_TakeInventory("BlasterPistolSelected",1)
				TNT1 A 0 A_TakeInventory("TacticalPistolSelected",1)
				TNT1 A 0 A_TakeInventory("MagnumSelected",1)
				TNT1 A 0 A_TakeInventory("DesertEagleSelected",1)
				TNT1 A 0 A_TakeInventory("PumpShotgunSelected",1)
				TNT1 A 0 A_TakeInventory("SlugShotgunSelected",1)
				TNT1 A 0 A_TakeInventory("LeverActionSelected",1)
				TNT1 A 0 A_TakeInventory("DoubleBarrelShotgunSelected",1)
				TNT1 A 0 A_TakeInventory("QuadBarrelShotgunSelected",1)
				TNT1 A 0 A_TakeInventory("SubMachineGunSelected",1)
				TNT1 A 0 A_TakeInventory("MP40Selected",1)
				TNT1 A 0 A_TakeInventory("AssaultRifleSelected",1)
				TNT1 A 0 A_TakeInventory("LightMachineGunSelected",1)
				TNT1 A 0 A_TakeInventory("SniperSelected",1)
				TNT1 A 0 A_TakeInventory("DMRSelected",1)
				TNT1 A 0 A_TakeInventory("MiniGunSelected",1)
				TNT1 A 0 A_TakeInventory("NailgunSelected",1)
				TNT1 A 0 A_TakeInventory("MG42Selected",1)
				TNT1 A 0 A_TakeInventory("ThumperSelected",1)
				TNT1 A 0 A_TakeInventory("GuidedRocketLauncherSelected",1)
				TNT1 A 0 A_GiveInventory("ExcavatorSelected",1)
				TNT1 A 0 A_TakeInventory("M1PlasmaRifleSelected",1)
				TNT1 A 0 A_TakeInventory("M2PlasmaRifleSelected",1)
				TNT1 A 0 A_TakeInventory("CryoRifleSelected",1)
				TNT1 A 0 A_TakeInventory("FlamerSelected",1)
				TNT1 A 0 A_TakeInventory("RailGunSelected",1)
				TNT1 A 0 A_TakeInventory("BigFuckingGunSelected",1)
				TNT1 A 0 A_TakeInventory("BallistaSelected",1)
				TNT1 A 0 A_TakeInventory("DemonicRifleSelected",1)
				TNT1 A 0 A_TakeInventory("FrostburnDeviceSelected",1)
				TNT1 A 0 A_TakeInventory("HasFlare",1)
				TNT1 A 0 A_TakeInventory("HasQuickLauncher",1)
				TNT1 A 0 A_TakeInventory("HasBarrel",1)
				TNT1 A 0 A_TakeInventory("HasIceBarrel", 1)
				TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
				TNT1 A 0 A_TakeInventory("EquippedObject",1)
				TNT1 A 0 {
					if( CountInv ("RadSuitOn") >= 1 ) {
						A_overlay(800,"WearingRadSuit",false);
						A_overlayflags(800, PSPF_ADDBOB, false);
						A_overlayflags(800, PSPF_ALPHA | PSPF_RENDERSTYLE, true);
						A_OverlayRenderstyle(800,STYLE_Translucent);
						A_overlayalpha(800,0.8);
					}
				}
				TNT1 AAAAAAAAAAAAAAAAAA 0 A_Raise
				TNT1 AAAAAAAA 1 A_Raise
				Wait

		Fire:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "PrimaryFireObject")
			TNT1 A 0 A_SetCrosshair(78)
			TNT1 A 0 A_JumpIfInventory("SawBladeMode", 1, "FireSawBlade")
			
		FireBola:
			TNT1 A 0 A_JumpIfInventory ("ExcavatorAmmo",1,1)
			Goto Reload
			TNT1 AAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-16,16), 0, -1, random(-9,9))
			TNT1 A 0 A_FireCustomMissile("RedFlareSpawn",-5,0,0,0)
			TNT1 A 0 A_PlaySound ("excavator_bolalaunch")
			TNT1 A 0 A_AlertMonsters
			TNT1 A 0 A_FireCustomMissile("Alerter")
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_FireCustomMissile("ExcavatorBola")
			EX_A JK 1 BRIGHT 
			TNT1 A 0 A_TakeInventory("ExcavatorAmmo",1)
			TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
			EX_A L 1 BRIGHT A_ZoomFactor(0.97)
			EX_A M 1 BRIGHT A_ZoomFactor(0.98)
			EX_A N 1 A_ZoomFactor(0.99)
			TNT1 A 0 A_ZoomFactor(1.0)
			EX_A OPQR 1 A_WeaponReady(WRF_NOPRIMARY)
			TNT1 A 0 A_PlaySound("RLCYCLE2", 5)
			EX_A EEEEEEEEEE 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
			Goto Ready3
			
		FireSawBlade:
			TNT1 A 0 A_JumpIfInventory ("ExcavatorAmmo",1,1)
			Goto Reload
			TNT1 A 0 A_GiveInventory("HitboxBladedDamage",1)
			TNT1 AAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-16,16), 0, -1, random(-9,9))
			TNT1 A 0 A_PlaySound ("excavator_fire_razor")
			TNT1 A 0 A_AlertMonsters
			TNT1 A 0 A_FireCustomMissile("Alerter")
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_FireCustomMissile("Razorblade")
			EX_C JK 1 BRIGHT 
			TNT1 A 0 A_TakeInventory("ExcavatorAmmo",1)
			TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
			EX_C L 1 BRIGHT A_ZoomFactor(0.97)
			EX_C M 1 A_ZoomFactor(0.98)
			EX_C N 1 A_ZoomFactor(0.99)
			TNT1 A 0 A_ZoomFactor(1.0)
			EX_C OPQR 1 A_WeaponReady(WRF_NOPRIMARY)
			TNT1 A 0 A_PlaySound("RLCYCLE2", 5)
			EX_C EEEEEEEEEE 1 A_WeaponReady(WRF_NOPRIMARY)
			TNT1 A 0
			Goto Ready3

		AltFire:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "AltFireObject")
			TNT1 A 0 A_SetCrosshair(78)
			TNT1 A 0 A_JumpIfInventory("SawBladeMode", 1, "ChargeSawBlade")
			
		FireGrenades:
			TNT1 A 0 A_JumpIfInventory ("ExcavatorAmmo",1,1)
			Goto Reload
			TNT1 AAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-16,16), 0, -1, random(-9,9))
			TNT1 A 0 A_FireCustomMissile("RedFlareSpawn",-5,0,0,0)
			TNT1 A 0 A_PlaySound ("excavator_grenadelaunch")
			TNT1 A 0 A_AlertMonsters
			TNT1 A 0 A_FireCustomMissile("Alerter")
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_FireCustomMissile("ExcavatorGrenade")
			EX_A JK 1 BRIGHT 
			TNT1 A 0 A_TakeInventory("ExcavatorAmmo",1)
			TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
			EX_A L 1 BRIGHT A_ZoomFactor(0.97)
			EX_A M 1 BRIGHT A_ZoomFactor(0.98)
			TNT1 A 0 A_JumpIfInventory ("ExcavatorAmmo",1,1)
			Goto FinishBurst
			TNT1 AAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-16,16), 0, -1, random(-9,9))
			TNT1 A 0 A_FireCustomMissile("RedFlareSpawn",-5,0,0,0)
			TNT1 A 0 A_PlaySound ("excavator_grenadelaunch")
			TNT1 A 0 A_AlertMonsters
			TNT1 A 0 A_FireCustomMissile("Alerter")
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_FireCustomMissile("ExcavatorGrenade")
			EX_A JK 1 BRIGHT 
			TNT1 A 0 A_TakeInventory("ExcavatorAmmo",1)
			TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
			EX_A L 1 BRIGHT A_ZoomFactor(0.97)
			EX_A M 1 BRIGHT A_ZoomFactor(0.98)
			TNT1 A 0 A_JumpIfInventory ("ExcavatorAmmo",1,1)
			Goto FinishBurst
			TNT1 AAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-16,16), 0, -1, random(-9,9))
			TNT1 A 0 A_FireCustomMissile("RedFlareSpawn",-5,0,0,0)
			TNT1 A 0 A_PlaySound ("excavator_grenadelaunch")
			TNT1 A 0 A_AlertMonsters
			TNT1 A 0 A_FireCustomMissile("Alerter")
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_FireCustomMissile("ExcavatorGrenade")
			EX_A JK 1 BRIGHT 
			TNT1 A 0 A_TakeInventory("ExcavatorAmmo",1)
			TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
			EX_A L 1 BRIGHT A_ZoomFactor(0.97)
			EX_A M 1 BRIGHT A_ZoomFactor(0.98)
			TNT1 A 0 A_JumpIfInventory ("ExcavatorAmmo",1,1)
			Goto FinishBurst
			TNT1 AAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-16,16), 0, -1, random(-9,9))
			TNT1 A 0 A_FireCustomMissile("RedFlareSpawn",-5,0,0,0)
			TNT1 A 0 A_PlaySound ("excavator_grenadelaunch")
			TNT1 A 0 A_AlertMonsters
			TNT1 A 0 A_FireCustomMissile("Alerter")
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_FireCustomMissile("ExcavatorGrenade")
			EX_A JK 1 BRIGHT 
			TNT1 A 0 A_TakeInventory("ExcavatorAmmo",1)
			TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
			EX_A L 1 BRIGHT A_ZoomFactor(0.97)
			EX_A M 1 BRIGHT A_ZoomFactor(0.98)
		FinishBurst:
			EX_A N 1 A_ZoomFactor(0.99)
			TNT1 A 0 A_ZoomFactor(1.0)
			EX_A OPQR 1 A_WeaponReady(WRF_NOPRIMARY)
			TNT1 A 0 A_PlaySound("RLCYCLE2", 5)
			EX_A EEEEEEEEEE 1 A_WeaponReady(WRF_NOPRIMARY|WRF_NOSECONDARY)
			Goto Ready3
			
		ChargeSawBlade:
			TNT1 A 0 A_JumpIfInventory ("ExcavatorAmmo",1,1)
			Goto Reload
			TNT1 A 0 A_PlaySound ("excavator_sawcharge")
			TNT1 A 0 A_GiveInventory("HitboxBladedDamage",1)
			EX_C STU 3
			TNT1 A 0 A_Startsound("excavator_sawcharge_loop",2,CHANF_LOOP)
		SawBladeCharged:
			EX_C U 1
			TNT1 A 0 A_Jumpif(PressingAltFire(),"SawBladeCharged")
		FireSawBladeCharged:
			TNT1 A 0 A_Stopsound(2)
			TNT1 AAAAAA 0 A_FireCustomMissile("ShotgunParticles", random(-16,16), 0, -1, random(-9,9))
			TNT1 A 0 A_PlaySound ("excavator_fire_razor")
			TNT1 A 0 A_AlertMonsters
			TNT1 A 0 A_FireCustomMissile("Alerter")
			TNT1 A 0 A_ZoomFactor(0.96)
			TNT1 A 0 A_FireCustomMissile("HeatedRazorblade")
			EX_C K 1 BRIGHT 
			TNT1 A 0 A_TakeInventory("ExcavatorAmmo",1)
			TNT1 A 0 A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0)
			EX_C L 1 BRIGHT A_ZoomFactor(0.97)
			EX_C M 1 A_ZoomFactor(0.98)
			EX_C N 1 A_ZoomFactor(0.99)
			TNT1 A 0 A_ZoomFactor(1.0)
			EX_C OPQR 1 A_WeaponReady(WRF_NOPRIMARY)
			TNT1 A 0 A_PlaySound("RLCYCLE2", 5)
			EX_C EEEEEEEEEE 1 A_WeaponReady(WRF_NOPRIMARY)
			TNT1 A 0
			Goto Ready3
			
		Spawn:
			EX_Z A -1
			Stop
			
			
		Reload:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "ReloadObject")
			TNT1 A 0 A_Takeinventory("Reloading",1)
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",6,"Ready3")
			TNT1 A 0 A_JumpIfInventory("SawBladeMode", 1, "ReloadSaw")
			TNT1 A 0 A_JumpIfInventory("ExplosiveAmmo",1,1)
			Goto Ready3
			TNT1 A 0 A_Giveinventory("PB_LockScreenTilt",1)
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded", 1, "ReloadFromUnload")
			TNT1 A 0 A_PlaySound("Ironsights", 15)
			EX_E ABCD 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_E EEE 1
			EX_E FGHI 1 A_SetRoll(roll+1.2,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/sgl/cycle", 14)
			EX_E JKLM 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			TNT1 A 0 A_FireCustomMissile("RocketCaseSpawn",-30,0,-4,-4)
			EX_E NNNNN 1 
			TNT1 A 0 A_PlaySound("weapons/minigun/respect1", 13)
			EX_E OPQRST 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_E UVWX 1 
			EX_E YZ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_F ABCC 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_F CCC 1
			TNT1 A 0 A_PlaySound("excavator_magslap", 13)
			EX_F EFG 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			Goto InsertBullets
		ReloadFromUnload:
			TNT1 A 0 A_PlaySound("weapons/minigun/respect1", 13)
			EX_K CBA 1
			EX_E OPQRST 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_E UVWX 1 
			EX_E YZ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_F ABCC 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_F CCC 1
			TNT1 A 0 A_PlaySound("excavator_magslap", 13)
			EX_F EFG 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			Goto InsertBullets
		ReloadSaw:
			TNT1 A 0 A_JumpIfInventory("FuelAmmo",5,1)
			Goto Ready3
			TNT1 A 0 A_Giveinventory("PB_LockScreenTilt",1)
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded", 1, "ReloadFromUnloadSaw")
			TNT1 A 0 A_PlaySound("Ironsights", 15)
			EX_G ABCD 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_G EEEEE 1
			EX_G FGHI 1 A_SetRoll(roll+1.2,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/sgl/cycle", 14)
			EX_G JKLM 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			TNT1 A 0 A_FireCustomMissile("RocketCaseSpawn",-30,0,-4,-4)
			EX_G NNNNN 1 
			TNT1 A 0 A_PlaySound("weapons/minigun/respect1", 13)
			EX_G OPQRST 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_G UVWX 1 
			EX_G YZ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_H ABCC 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_H CCC 1
			TNT1 A 0 A_PlaySound("excavator_magslap", 13)
			EX_H EFG 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			Goto InsertBulletsSaw
		ReloadFromUnloadSaw:
			TNT1 A 0 A_PlaySound("weapons/minigun/respect1", 13)
			EX_L CBA 1
			EX_G OPQRST 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_G UVWX 1 
			EX_G YZ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_H ABCC 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_H CCC 1
			TNT1 A 0 A_PlaySound("excavator_magslap", 13)
			EX_H EFG 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			Goto InsertBulletsSaw
		InsertBullets:
			TNT1 A 0 A_JumpIfInventory("ExplosiveAmmo",1,1)
			Goto FinishReload
			TNT1 A 0 A_Giveinventory("ExcavatorAmmo",1)
			TNT1 A 0 A_Takeinventory("ExplosiveAmmo",1)
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",6,"FinishReload")
			Loop
		InsertBulletsSaw:
			TNT1 A 0 A_JumpIfInventory("FuelAmmo",5,1)
			Goto FinishReloadSaw
			TNT1 A 0 A_Giveinventory("ExcavatorAmmo",1)
			TNT1 A 0 A_Takeinventory("FuelAmmo",5)
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",6,"FinishReloadSaw")
			Loop
		FinishReload:
			EX_F HIJ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_F JIHGFL 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/nailgun/up", 10)
			EX_F MNO 1
			TNT1 A 0 A_PlaySound("excavator/detonate")
			EX_A EEEEE 1
			TNT1 A 0 {
				A_Takeinventory("PB_LockScreenTilt",1);
				A_Takeinventory("ExcavatorUnloaded",1);
			}
			Goto Ready3
		FinishReloadSaw:
			EX_H HIJ 1 A_SetRoll(roll+0.6,SPF_INTERPOLATE)
			EX_H JIHGFL 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/nailgun/up", 10)
			EX_H MNO 1
			TNT1 A 0 A_PlaySound("excavator/detonate")
			EX_C EEEEE 1
			TNT1 A 0 {
				A_Takeinventory("PB_LockScreenTilt",1);
				A_Takeinventory("ExcavatorUnloaded",1);
			}
			Goto Ready3
			
		Unload:
			TNT1 A 0 A_Giveinventory("PB_LockScreenTilt",1)
			TNT1 A 0 A_PlaySound("Ironsights", 15)
			TNT1 A 0 A_JumpIfInventory("SawBladeMode", 1, "UnloadSaw")
			EX_E ABCD 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_E EEE 1
			EX_E FGHI 1 A_SetRoll(roll+1.2,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/sgl/cycle", 14)
			EX_E JKLM 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			Goto RemoveBullets
		Unload2:
			EX_E NNNNN 1 
			EX_K ABC 1
			TNT1 A 0 {
				A_GiveInventory("ExcavatorUnloaded", 1);
				A_Takeinventory("Unloading",1);
				A_Takeinventory("PB_LockScreenTilt",1);
			}
			Goto Ready3
		RemoveBullets:
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",1,1)
			Goto Unload2
			TNT1 A 0 
			{
				A_Takeinventory("ExcavatorAmmo",1);
				A_Giveinventory("ExplosiveAmmo",1);
			}
			Goto RemoveBullets
			
		UnloadSaw:
			EX_G ABCD 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			EX_G EEEEE 1
			EX_G FGHI 1 A_SetRoll(roll+1.2,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySound("weapons/sgl/cycle", 14)
			EX_G JKLM 1 A_SetRoll(roll-0.6,SPF_INTERPOLATE)
			Goto RemoveBulletsSaw
		UnloadSaw2:
			EX_G NNNNN 1 
			EX_L ABC 1
			TNT1 A 0 {
				A_GiveInventory("ExcavatorUnloaded", 1);
				A_Takeinventory("Unloading",1);
				A_Takeinventory("PB_LockScreenTilt",1);
			}
			Goto Ready3
		RemoveBulletsSaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorAmmo",1,1)
			Goto UnloadSaw2
			TNT1 A 0 
			{
				A_Takeinventory("ExcavatorAmmo",1);
				A_Giveinventory("FuelAmmo",5);
			}
			Goto RemoveBulletsSaw
			
		FlashKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashKickingObject")
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"FlashKickingSaw")
		FlashKickingBola:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashKickingBolaUnloaded")
			EX_A FGHI 1 
			EX_A I 6
			EX_A IHGF 1
			Stop
		FlashKickingBolaUnloaded:
			EX_B FGHI 1 
			EX_B I 6
			EX_B IHGF 1
			Stop
		FlashKickingSaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashKickingSawUnloaded")
			EX_C FGHI 1 
			EX_C I 6
			EX_C IHGF 1
			Stop
		FlashKickingSawUnloaded:
			EX_D FGHI 1 
			EX_D I 6
			EX_D IHGF 1
			Stop
			
		FlashAirKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashAirKickingObject")
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"FlashAirKickingSaw")
		FlashAirKickingBola:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashAirKickingBolaUnloaded")
			EX_A FGHI 1 
			EX_A I 8
			EX_A IHGF 1
			Stop
		FlashAirKickingBolaUnloaded:
			EX_B FGHI 1 
			EX_B I 8
			EX_B IHGF 1
			Stop
		FlashAirKickingSaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashAirKickingSawUnloaded")
			EX_C FGHI 1 
			EX_C I 8
			EX_C IHGF 1
			Stop
		FlashAirKickingSawUnloaded:
			EX_D FGHI 1 
			EX_D I 8
			EX_D IHGF 1
			Stop
			
		FlashSlideKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashSlideKickingObject")
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"FlashSlideKickingSaw")
		FlashSlideKickingBola:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashSlideKickingBolaUnloaded")
			EX_A FGHI 1 
			EX_A I 21
			Stop
		FlashSlideKickingBolaUnloaded:
			EX_B FGHI 1 
			EX_B I 21
			Stop
		FlashSlideKickingSaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashSlideKickingSawUnloaded")
			EX_C FGHI 1 
			EX_C I 21
			Stop
		FlashSlideKickingSawUnloaded:
			EX_D FGHI 1 
			EX_D I 21
			Stop
			
		FlashSlideKickingStop:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashSlideKickingStopObject")
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"FlashSlideKickingStopSaw")
		FlashSlideKickingStopBola:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashSlideKickingStopBolaUnloaded")
			EX_A IIIIHGF 1 
			Stop
		FlashSlideKickingStopBolaUnloaded:
			EX_B IIIIHGF 1 
			Stop
		FlashSlideKickingStopSaw:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashSlideKickingStopSawUnloaded")
			EX_C IIIIHGF 1  
			Stop
		FlashSlideKickingStopSawUnloaded:
			EX_D IIIIHGF 1 
			Stop

		FlashPunching:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashPunchingObject")
			TNT1 A 0 A_JumpIfInventory("SawBladeMode",1,"FlashPunchingSawMode")
		FlashPunchingBola:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashPunchingBolaUnloaded")
			EX_A FGHI 1 
			EX_A I 6
			EX_A IHGF 1
			Stop
		FlashPunchingBolaUnloaded:
			EX_B FGHI 1 
			EX_B I 6
			EX_B IHGF 1
			Stop
		FlashPunchingSawMode:
			TNT1 A 0 A_JumpIfInventory("ExcavatorUnloaded",1,"FlashPunchingSawUnloaded")
			EX_C FGHI 1 
			EX_C I 6
			EX_C IHGF 1
			Stop
		FlashPunchingSawUnloaded:
			EX_D FGHI 1 
			EX_D I 6
			EX_D IHGF 1
			Stop
	}
}

Actor BolaStuckOnMonster : Inventory
{Inventory.MaxAmount 1}

ACTOR ExcavatorBola
{
	DamageType Explosive
    +MISSILE
    +BLOODSPLATTER
	+EXTREMEDEATH
	+FORCEXYBILLBOARD
	+DONTBOUNCEONSHOOTABLES
	-EXPLODEONWATER
	-NOEXTREMEDEATH
	+CANBOUNCEWATER
	+SOLID
	+BOUNCEONWALLS
	+BOUNCEONFLOORS
	+BOUNCEONCEILINGS
	+MOVEWITHSECTOR
	+USEBOUNCESTATE
    +DONTSPLASH
	+HITTRACER
    Gravity 0.5
	Scale 0.35
	Damage 0
    BounceFactor 0.1
	Radius 5
    Height 2
	speed 35
	Damagetype "ExplosiveImpact"
	DeathSound ""
	var int user_stickycounter;
	var int user_stuckEnemy;
	States
	{
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_Startsound("excavator_bolafly_loop",6,CHANF_LOOP)
		Fly:
			TNT1 A 0 {
				if(waterlevel > 1) {A_SpawnItem ("RocketSmokeTrail52"); }
				else {A_CustomMissile ("BUBULZ", 0, 0, random (0, 360), 2, random (0, 180));}
				A_SpawnItem("RedFlareSmall",0,0);
			}
			EX_V ABCDEFGHIJGFEDCBA 2 Bright Light("SGL_STICKY") A_JumpIfInventory("GrenadeDetonator",1,"Detonate",AAPTR_TARGET) 
			Loop
			
		Bounce:
		Death:
		Crash:
			TNT1 A 0 {
				A_NoGravity;
				A_ScaleVelocity(0);
				A_StopSound(6);
			}
			EX_V CCCCCCCCCC 1 BRIGHT 
			GoTo Detonate
	
		XDeath:
		Bounce.Creature:
			EX_V D 1 {
				A_StopSound(6);
				A_Changeflag("THRUACTORS", 1);
				A_Changeflag("Solid", 1);
				A_Stop;
			}
			EX_V D 1 {
				A_Changeflag("THRUACTORS", 0);
				A_Changeflag("Solid", 0);
				A_GiveInventory("BolaStuckOnMonster",1);
			}
			EX_V KKKKKKKKKK 1 BRIGHT A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION)
			Goto DetonateMonster
			
		Detonate:
			TNT1 A 0 A_JumpIfInventory("BolaStuckOnMonster",1,"DetonateMonster")
			TNT1 A 0 A_PlaySound("StunGrenadeDetonate", 6)
			EX_V CCCCC 1 BRIGHT 
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,0)
			EX_V CCCC 1 BRIGHT 
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,0)
			EX_V CCC 1 BRIGHT 
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,0)
			EX_V CC 1 BRIGHT 
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,0)
			EX_V C 1 BRIGHT 
			Goto Explosion
		DetonateMonster:
			TNT1 A 0 A_PlaySound("StunGrenadeDetonate", 6)
			EX_V KKKKKKKKKK 1 BRIGHT A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,32)
			EX_V KKKKK 1 BRIGHT A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,32)
			EX_V KKKK 1 BRIGHT A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,32)
			EX_V KKK 1 BRIGHT A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,32)
			EX_V KK 1 BRIGHT A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,32)
			EX_V K 1 BRIGHT A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION)
			Goto Explosion
		Explosion:
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,0)
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,0)
			TNT1 A 0 A_SpawnItem("RedFlareSmall",0,0)
			EXPL A 0 Radius_Quake (3, 24, 0, 15, 0)//(intensity, duration, damrad, tremrad, tid)
			TNT1 A 0 A_CustomMissile("BigRicoChet")
			TNT1 A 0 A_SpawnItem ("BigRicoChet", 0, -30)
			TNT1 A 0 A_SpawnItemEx ("DetectFloorCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_SpawnItemEx ("UnderwaterExplosion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_SpawnItemEx ("ExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_SpawnItemEx ("NewGroundExplosionSmoke",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 AAAA 0 A_CustomMissile ("FireworkSFXType2", 0, 0, random (0, 360), 2, random (30, 60))
			TNT1 AAAAAAAAA 0 A_CustomMissile ("ExplosionParticleHeavy", 0, 0, random (0, 360), 2, random (0, 180))
			TNT1 AAAAAAAAA 0 A_CustomMissile ("ExplosionParticleVeryFast", 0, 0, random (0, 360), 2, random (0, 360))
			TNT1 AAAAA 0 A_CustomMissile ("MediumExplosionFlames", 0, 0, random (0, 360), 2, random (0, 360))
			EXPL AAAAA 0 A_CustomMissile ("ExplosionSmokeFast22", 0, 0, random (0, 360), 2, random (0, 360))
			TNT1 A 0 A_SpawnItemEx ("LiquidExplosionEffectSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_CustomMissile ("ExcavatorExploFX", random(1,5), random(-10,10), random (0, 360), 2, random (0, 360))
			TNT1 A 0 A_SpawnItemEx ("ExcavatorExplosion",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_Playsound("excavator/explode", 1)
			TNT1 A 0 A_PlaySound("FAREXPL", 3)
			Stop
	}
}

ACTOR ExcavatorGrenade
{
	DamageType Explosive
    +MISSILE
    +BLOODSPLATTER
	+EXTREMEDEATH
	+FORCEXYBILLBOARD
	+DONTBOUNCEONSHOOTABLES
	-EXPLODEONWATER
	-NOEXTREMEDEATH
	+CANBOUNCEWATER
	+SOLID
	+BOUNCEONWALLS
	+BOUNCEONFLOORS
	+BOUNCEONCEILINGS
	+MOVEWITHSECTOR
	+USEBOUNCESTATE
    +DONTSPLASH
	+HITTRACER
    Gravity 0.5
	Scale 0.35
	Damage 0
    BounceFactor 0.1
	Radius 2
    Height 2
	speed 35
	Damagetype "ExplosiveImpact"
	DeathSound ""
	var int user_stickycounter;
	var int user_stuckEnemy;
	States
	{
		Spawn:
			TNT1 A 0 {
				if(waterlevel > 1) {A_SpawnItem ("RocketSmokeTrail52"); }
				else {A_CustomMissile ("BUBULZ", 0, 0, random (0, 360), 2, random (0, 180));}
				A_SpawnItem("RedFlareSmall",0,0);
			}
			GRNP A 1 Bright Light("SGL_STICKY") A_JumpIfInventory("GrenadeDetonator",1,"Detonate",AAPTR_TARGET) 
			Loop
			
		Bounce:
		Death:
		Crash:
			TNT1 A 0 {
				user_stickycounter = 0;
				A_NoGravity;
				A_ScaleVelocity(0);
			}
		Stuck:
			TNT1 A 0 A_Playsound ("RAILR1")
			GRNP AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA 1 BRIGHT Light("SGL_STICKY") {
				if(user_stuckEnemy == 1) {

					if(AAPTR_TRACER) {
						A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION);
					}
					else {
						A_Fall;
					}
				return state("");
			}
		return state("");
	}
			TNT1 A 0 {
				A_SpawnItem("RedFlareSmall",0,0);
				user_stickycounter++;
			}
			TNT1 A 0 A_JumpIf(user_stickycounter < 1, "Stuck")
			TNT1 A 0 A_PlaySound("StunGrenadeDetonate", 6)
			TNT1 A 0 A_JumpIf(user_stickycounter > 1, "Detonate")
			GoTo Detonate
	
		XDeath:
		Bounce.Creature:
			GRNP A 1 {
				A_Changeflag("THRUACTORS", 1);
				A_Changeflag("Solid", 1);
				user_stuckEnemy = 1;
				A_Stop;
			}
			GRNP A 1 {
				A_Changeflag("THRUACTORS", 0);
				A_Changeflag("Solid", 0);
			}
			Goto Stuck
			
		Detonate:
			TNT1 A 0 A_StopSound(6)
			TNT1 A 0 A_PlaySound("Explosion",4)
			TNT1 A 0 A_SpawnItem ("BigRicoChet", 0, -30)
			TNT1 AAA 0 A_CustomMissile ("ExplosionSmoke", 22, 0, random (0, 360), 2, random (0, 360))
			TNT1 A 0 A_SpawnItemEx ("ExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_SpawnItemEx ("DetectFloorCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_SpawnItemEx ("DetectCeilCrater",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_SpawnItemEx ("StickyExplosion",0,0,-2,0,0,0,0,SXF_NOCHECKPOSITION,0)
			TNT1 A 0 A_SpawnItemEx ("NewRocketExploFX", 0, 0, 0)
			TNT1 AAAAAAAAA 0 A_CustomMissile ("ExplosionParticleHeavy", 0, 0, random (0, 360), 2, random (0, 360))
			TNT1 AAAAAAAAA 0 A_CustomMissile ("ExplosionParticleVeryFast", 0, 0, random (0, 360), 2, random (0, 360))
			XXXX A 0 A_CustomMissile ("ExplosionQuake", 1, 0, random (0, 360), 2, random (0, 160))
			TNT1 AAAAAAAAA 0 A_CustomMissile ("MediumExplosionFlames", 0, 0, random (0, 360), 2, random (0, 360))
			TNT1 A 0 A_Playsound("excavator/explode", 1)
			TNT1 A 0 A_PlaySound("FAREXPL",3)
			EXPL AAA 0 A_CustomMissile ("ExplosionSmoke", 0, 0, random (0, 360), 2, random (0, 360))  
			Stop
	}
}
				
Actor Razorblade {
	radius 6
	height 8
	Scale 0.75
	speed 60
	damage 25
	seesound ""
	deathsound ""
	Obituary "%o's guts were shredded by %k's flying blade."
	DamageType "Saw"
	Gravity 0
	WallBounceFactor 1
	BounceFactor 1
	Bouncecount 1
	Bouncesound "sawblade/ricochet"
	+BounceOnWalls
	+BounceOnFloors
	+BounceOnCeilings
	+BounceOnActors
	+CanBounceWater
	+UseBounceState
	PROJECTILE
	+RIPPER
	-NOGRAVITY
		states {
			Spawn:
				EX_V L 0 NoDelay
				EX_V LL 1 {
					A_SpawnItemEx("RazorbladeTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE);
					A_CustomMissile ("SparkX", 0, 0, random (-160, -200), 2, random (30, 170));
					A_CustomMissile ("SparkX", 0, 0, random (-160, -200), 2, random (30, 170));
					A_CustomMissile ("SparkX", 0, 0, random (-160, -200), 2, random (30, 170));
				}
				EX_V MM 1 {
					A_SpawnItemEx("RazorbladeTrail",0,0,0,0,0,0,0,SXF_CLIENTSIDE);
					A_CustomMissile ("SparkX", 0, 0, random (-160, -200), 2, random (30, 170));
					A_CustomMissile ("SparkX", 0, 0, random (-160, -200), 2, random (30, 170));
					A_CustomMissile ("SparkX", 0, 0, random (-160, -200), 2, random (30, 170));
				}
				TNT1 A 0 A_ChangeFlag("HitOwner",1)
				Loop
			Bounce:
			Death:
			XDeath:
				TNT1 A 0 {
					A_PlaySoundEx("weapons/ballista/razor","Auto");
					A_SetGravity(1.0);
				}
				TNT1 A 0 A_SpawnItemEx ("RicoChet",0,0,-5,0,0,0,0,SXF_NOCHECKPOSITION,0)
				EX_V L 100
				EX_V LLLLLLLLLLLLLLL 1 A_FadeOut(0.15)
				Stop	}}

ACTOR RazorbladeTrail {
	radius 6
	height 8
	Scale 0.95
	Alpha 0.95
	+NOCLIP
	+NOINTERACTION
	Renderstyle Translucent
		States {
			Spawn:
			EX_V LLLLLLLLLLLLLLL 1 A_FadeOut(0.15)
			Stop	}}
			
Actor HeatedRazorblade {
	radius 6
	height 8
	Scale 0.75
	speed 60
	damage 30
	seesound ""
