Actor RespectCryoRifle: Inventory
{
Inventory.maxamount 1
}

Actor CryoRifleHasUnloaded: Inventory
{
Inventory.maxamount 1
}

Actor CryoRifleFireModeDefence: Inventory
{
Inventory.maxamount 1
}

ACTOR CryoRifle : PB_Weapon
{
	Weapon.BobRangeX 0.3
	Weapon.BobRangeY 0.5
	Weapon.BobStyle InverseSmooth
	Weapon.BobSpeed 2.4
	Game Doom
	Weapon.SelectionOrder 1300
	Weapon.AmmoUse1 0
	Weapon.AmmoGive1 80
	Weapon.AmmoUse2 0
	Weapon.AmmoGive2 40
	+FLOORCLIP
	+DONTGIB
	Scale 0.5
	Weapon.AmmoType1 "PlasmaAmmo"
	Weapon.AmmoType2 "CryoRifleAmmo"
	Inventory.PickupMessage "Cryo Rifle (Slot 7)"
	Inventory.PickupSound "weapons/freezer/respect1"
	Damagetype "Freeze"
	Obituary "%k Iced %o with a Cryo Rifle"
	Tag "Cryo Rifle"
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	PB_WeaponBase.UnloaderToken "CryoRifleHasUnloaded"
	States
	{
		Steady:
			TNT1 A 1
			Goto Ready
			
		Ready:
			TNT1 A 0 {	
				A_Takeinventory("Unloading",1);
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
				A_ZoomFactor(1.0);
			}
			FR08 ABCDEF 0  
			FR05 A 0
			TNT1 A 0 A_JumpIfInventory("RespectCryoRifle", 1, "SelectAnimation")
		Respect:
			"####" "#" 0 A_GiveInventory("RespectCryoRifle")
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
			TNT1 A 0 {
				A_SetCrosshair(5);
				A_Giveinventory("PB_LockScreenTilt",1);
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
			}
			TNT1 AAAAAA 1 {
				A_SetRoll(roll+0.3,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/up", "Auto")
			FR08 ABCDEFGHIJ 1 {
				A_SetRoll(roll-0.3,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/reload1", "Auto")
			FR08 KLMNO 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaysoundEx("weapons/freezer/idle", "Auto")
			FR08 PQRSTUOPQRSTU 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaysoundEx("weapons/freezer/respect3", "Auto")
			FR08 VWXYZZZ 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaysoundEx("IronSights", "Auto")
			FR07 EFGH 1 A_DoPBWeaponAction
			TNT1 A 0 A_PlaysoundEx("weapons/freezer/respect1", "Auto")
			FR07 ONMLKJIHGF 1 A_DoPBWeaponAction
			FR07 EDCA 1 {
				A_DoPBWeaponAction;
				A_SetRoll(roll+0.3,SPF_INTERPOLATE);
			}
			TNT1 A 0 A_Takeinventory("PB_LockScreenTilt",1)
			"####" "#" 0 A_JumpIfInventory ("CryoRifleFireModeDefence", 1, "SwapToDefence")
			Goto Ready3
		SelectAnimation:
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/up", "Auto")
			TNT1 A 0 {
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
			}
			FR08 ABCDEF 1  
			FR05 A 1  

		Ready3:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
			TNT1 A 0 {
				A_ClearOverlays(10,11);
				A_SetRoll(0);
				A_SetCrosshair(94);
				A_PlaySound("weapons/freezer/idle", 1, 1.0, 1);
				A_PlaySound("PLSIDLE", 6, 0.7, 1);
				A_TakeInventory("PB_LockScreenTilt",1);
			}
		ReadyToFire:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
			"####" "#" 0 A_JumpIfInventory ("CryoRifleAmmo", 1, 1)
			Goto GunEmpty
			"####" "#" 0 A_JumpIfInventory ("CryoRifleFireModeDefence", 1, "ReadyToFire2")
			FR05 A 1 {
				A_FireCustomMissile("TinyGunSmoker", 0, 0, 0, -3, 0, 0);
				return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
			}
			Loop
		ReadyToFire2:
			FR05 BCDEFEDCB 1 {
				A_FireCustomMissile("TinyGunSmoker", 0, 0, 0, -3, 0, 0);
				return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
			}
			Goto ReadyToFire
		GunEmpty:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
			"####" "#" 0 A_JumpIfInventory ("CryoRifleFireModeDefence", 1, "GunEmpty2")
			TNT1 A 0 {
				A_StopSound(1);
				A_StopSound(6);
			}
			FR05 A 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
			Goto GunEmpty
		GunEmpty2:
			TNT1 A 0 {
				A_StopSound(1);
				A_StopSound(6);
			}
			FR05 G 1 A_DoPBWeaponAction(WRF_ALLOWRELOAD)
			Goto GunEmpty
		WeaponSpecial:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "WeaponSpecialObject")
			TNT1 A 0 {
				A_Takeinventory("GoWeaponSpecialAbility",1);
				A_GiveInventory("PB_LockScreenTilt",1);
				A_SetCrosshair(94);
				A_ClearOverlays(10,11);
				A_StopSound(1);
				A_StopSound(6);
			}
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"SwitchToAssault")
		SwitchToDefence:
			TNT1 A 0 {
				A_GiveInventory("CryoRifleFireModeDefence", 1);
				A_Print("Fire Mode: Defence");
				A_PlaySoundEx("IronSights", "Auto");
			}
			FR06 ABCDEEEEE 1 
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/respect1", "Auto")
			FR06 FGHIJKLMNOPQ 1 A_FireCustomMissile("GunFireSmoke", 0, 0, -5, -5, 0, 0)
			Goto Ready3
		SwitchToAssault:
			TNT1 A 0 {
				A_TakeInventory("CryoRifleFireModeDefence", 1);
				A_Print("Fire Mode: Assault");
				A_PlaySoundEx("IronSights", "Auto");
			}
			FR06 QPONMMMMM 1 
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/respect2", "Auto")
			FR06 LKJIHGFEDCBA 1 A_FireCustomMissile("GunFireSmoke", 0, 0, -5, -5, 0, 0)
			Goto Ready3
		
		Deselect:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "DeselectObject")
			TNT1 A 0 {
				A_SetRoll(0);
				A_SetCrosshair(94);
				A_TakeInventory("PB_LockScreenTilt",1);
				A_ClearOverlays(10,11);	
				A_Takeinventory("Unloading",1);
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
				A_ZoomFactor(1.0);
				A_StopSound(1);
				A_StopSound(6);
			}
			FR05 A 1 
			FR08 FEDCBA 1  
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
			Wait

		Select:
			TNT1 A 0 {
				A_SetRoll(0);
				A_SetCrosshair(94);
				A_TakeInventory("PB_LockScreenTilt",1);
			}
			TNT1 A 0 A_Overlay(-10, "FirstPersonLegsStand")
			TNT1 A 0 A_Takeinventory("CryoRifleHasUnloaded",1)
			TNT1 A 0 A_Takeinventory("Unloading",1)
			TNT1 A 0 A_Takeinventory("RandomHeadExploder",1)
			TNT1 A 0 A_Takeinventory("HitboxFireDamage",1)
			TNT1 A 0 A_Giveinventory("HitboxIceDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxAcidDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxPlasmaDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxDemonicDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxBladedDamage",1)
			TNT1 A 0 A_TakeInventory("BlasterPistolSelected",1)
			TNT1 A 0 A_TakeInventory("TacticalPistolSelected",1)
			TNT1 A 0 A_TakeInventory("MagnumSelected",1)
			TNT1 A 0 A_TakeInventory("DesertEagleSelected",1)
			TNT1 A 0 A_TakeInventory("PumpShotgunSelected",1)
			TNT1 A 0 A_TakeInventory("SlugShotgunSelected",1)
			TNT1 A 0 A_TakeInventory("LeverActionSelected",1)
			TNT1 A 0 A_TakeInventory("DoubleBarrelShotgunSelected",1)
			TNT1 A 0 A_TakeInventory("QuadBarrelShotgunSelected",1)
			TNT1 A 0 A_TakeInventory("SubMachineGunSelected",1)
			TNT1 A 0 A_TakeInventory("MP40Selected",1)
			TNT1 A 0 A_TakeInventory("AssaultRifleSelected",1)
			TNT1 A 0 A_TakeInventory("LightMachineGunSelected",1)
			TNT1 A 0 A_TakeInventory("SniperSelected",1)
			TNT1 A 0 A_TakeInventory("DMRSelected",1)
			TNT1 A 0 A_TakeInventory("MiniGunSelected",1)
			TNT1 A 0 A_TakeInventory("NailgunSelected",1)
			TNT1 A 0 A_TakeInventory("MG42Selected",1)
			TNT1 A 0 A_TakeInventory("ThumperSelected",1)
			TNT1 A 0 A_TakeInventory("GuidedRocketLauncherSelected",1)
			TNT1 A 0 A_TakeInventory("ExcavatorSelected",1)
			TNT1 A 0 A_TakeInventory("M1PlasmaRifleSelected",1)
			TNT1 A 0 A_TakeInventory("M2PlasmaRifleSelected",1)
			TNT1 A 0 A_GiveInventory("CryoRifleSelected",1)
			TNT1 A 0 A_TakeInventory("FlamerSelected",1)
			TNT1 A 0 A_TakeInventory("RailGunSelected",1)
			TNT1 A 0 A_TakeInventory("BigFuckingGunSelected",1)
			TNT1 A 0 A_TakeInventory("BallistaSelected",1)
			TNT1 A 0 A_TakeInventory("DemonicRifleSelected",1)
			TNT1 A 0 A_TakeInventory("FrostburnDeviceSelected",1)
			TNT1 A 0 A_TakeInventory("HasFlare",1)
			TNT1 A 0 A_TakeInventory("HasQuickLauncher",1)
			TNT1 A 0 A_TakeInventory("HasBarrel",1)
			TNT1 A 0 A_TakeInventory("HasIceBarrel", 1)
			TNT1 A 0 A_TakeInventory("HasFlameBarrel",1) 
			TNT1 A 0 A_TakeInventory("EquippedObject",1)
			TNT1 A 0 {
				if( CountInv ("RadSuitOn") >= 1 ) {
					A_overlay(800,"WearingRadSuit",false);
					A_overlayflags(800, PSPF_ADDBOB, false);
					A_overlayflags(800, PSPF_ALPHA | PSPF_RENDERSTYLE, true);
					A_OverlayRenderstyle(800,STYLE_Translucent);
					A_overlayalpha(800,0.8);
				}
			}
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Raise
			TNT1 AAAAAAAA 1 A_Raise
			Wait
		
		Fire:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "PrimaryFireObject")
			TNT1 A 0 {
				A_WeaponOffset(0,32);
				A_SetRoll(0);
				A_SetCrosshair(94);
				A_TakeInventory("PB_LockScreenTilt",1);
			}
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",3,1)
			Goto Reload
			TNT1 A 0 A_JumpIfInventory ("CryoRifleFireModeDefence", 1, "HoldLaser")
		HoldMissile:
			TNT1 AAAAAAAAAA 0 A_FireCustomMissile("BluePlasmaParticle",random(10,-10),0,0,random(-3,3),0,random(7,-7) )
			FR09 ABCD 0 // Initialize sprites into virtual memory
			FR09 A 1 Bright {
				A_GunFlash;
				A_Overlay(-2, "BeamMuzzleFlash");
				A_Takeinventory("CryoRifleAmmo",3);
				A_AlertMonsters(450);
				A_Playsound("weapons/freezer/laser");
				A_FireCustomMissile("FreezerBeam", 0, 0, 0, 0);
				A_FireCustomMissile("FreezerBeam", 0, 0, 0, 0);
				A_FireCustomMissile("BlueFlareSpawn",0,0,0,0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				
				A_ZoomFactor(0.98);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.32, SPF_INTERPOLATE);
					A_SetAngle(angle+0.15, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.24, SPF_INTERPOLATE);
					A_SetAngle(angle+0.6, SPF_INTERPOLATE);
				}
			}
			FR09 B 1 Bright {
				
				A_ZoomFactor(0.99);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.32, SPF_INTERPOLATE);
					A_SetAngle(angle+0.15, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.24, SPF_INTERPOLATE);
					A_SetAngle(angle+0.6, SPF_INTERPOLATE);
				}
			}
			FR09 C 1 Bright {
				A_ZoomFactor(1.0);
			} 
			FR09 D 1 Bright 
			FR05 AAAAAA 1 
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",3,1)
			Goto EndMissile
			TNT1 A 0
			TNT1 A 0 A_Refire ("HoldMissile")
			Goto EndMissile
		HoldLaser:
			TNT1 AAAAAAAAAA 0 A_FireCustomMissile("BluePlasmaParticle",random(10,-10),0,0,random(-3,3),0,random(7,-7) )
			FR09 EFGH 0 // Initialize sprites into virtual memory
			FR09 E 1 Bright {
				A_GunFlash;
				A_Overlay(-2, "BeamMuzzleFlash");
				A_Takeinventory("CryoRifleAmmo",3);
				A_AlertMonsters(450);
				A_Playsound("weapons/freezer/missile");
				A_FireCustomMissile("FreezerBall", 0, 0, 0, 0);
				A_FireCustomMissile("BlueFlareSpawn",0,0,0,0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_ZoomFactor(0.98);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.32, SPF_INTERPOLATE);
					A_SetAngle(angle+0.15, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.24, SPF_INTERPOLATE);
					A_SetAngle(angle+0.6, SPF_INTERPOLATE);
				}
			}
			FR09 F 1 Bright {
				A_FireCustomMissile("FreezerBeam", 0, 0, 0, 0);
				A_FireCustomMissile("FreezerBeam", 0, 0, 0, 0);
				A_ZoomFactor(0.99);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.32, SPF_INTERPOLATE);
					A_SetAngle(angle+0.15, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.24, SPF_INTERPOLATE);
					A_SetAngle(angle+0.6, SPF_INTERPOLATE);
				}
			}
			FR09 G 1 Bright {
				A_FireCustomMissile("FreezerBeam", 0, 0, 0, 0);
				A_FireCustomMissile("FreezerBeam", 0, 0, 0, 0);
				A_ZoomFactor(1.0);
			} 
			FR09 H 1 Bright {
				A_FireCustomMissile("FreezerBeam", 0, 0, 0, 0);
				A_FireCustomMissile("FreezerBeam", 0, 0, 0, 0);
			}
			FR05 BCDEFG 1 
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",3,1)
			Goto EndMissile
			TNT1 A 0
			TNT1 A 0 A_Refire ("HoldLaser")
			Goto EndMissile
		EndMissile:
			TNT1 A 0 {
				A_StopSound(2);
				A_StopSound(6);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",3,1)
			Goto Reload
			TNT1 A 0
			Goto Ready3

		BeamMuzzleFlash:
			TNT1 A 0 A_Jump(256, "Muzzle1", "Muzzle2", "Muzzle3", "Muzzle4", "Muzzle5", "Muzzle6", "Muzzle7")
		Muzzle1:
			FR12 A 1 BRIGHT
			Stop
		Muzzle2:
			FR12 B 1 BRIGHT
			Stop
		Muzzle3:
			FR12 C 1 BRIGHT
			Stop
		Muzzle4:
			FR12 D 1 BRIGHT
			Stop
		Muzzle5:
			FR12 E 1 BRIGHT
			Stop
		Muzzle6:
			FR12 F 1 BRIGHT
			Stop
		Muzzle7:
			FR12 G 1 BRIGHT
			Stop
			
		AltFire:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "AltFireObject")
			TNT1 A 0 {
				A_WeaponOffset(0,32);
				A_SetRoll(0);
				A_SetCrosshair(94);
				A_TakeInventory("PB_LockScreenTilt",1);
			}
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"FireSpear")
			
		FireFlak:
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",5,1)
			Goto Reload
			TNT1 A 0 A_Playsound("weapons/freezer/powerup")
			FR10 AAAAABBBBBBCCCCCCDDDDD 1 
		HoldFlak:
			TNT1 AAAAAAAAAA 0 A_FireCustomMissile("BluePlasmaParticle",random(10,-10),0,0,random(-3,3),0,random(7,-7) )
			FR09 ABCD 0 // Initialize sprites into virtual memory
			FR09 A 1 Bright {
				A_GunFlash;
				A_Overlay(-2, "BeamMuzzleFlash");
				A_Takeinventory("CryoRifleAmmo",5);
				A_AlertMonsters(450);
				A_Playsound("weapons/freezer/flak");
				A_FireCustomMissile("IceFlak1",random(-2,2),0,0,random(0,-1));
				A_FireCustomMissile("IceFlak2",random(-2,2),0,0,random(0,-1));
				A_FireCustomMissile("IceFlak3",random(-2,2),0,0,random(0,-1));
				A_FireCustomMissile("BlueFlareSpawn",0,0,0,0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				
				A_ZoomFactor(0.98);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.72, SPF_INTERPOLATE);
					A_SetAngle(angle+0.25, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.64, SPF_INTERPOLATE);
					A_SetAngle(angle+0.7, SPF_INTERPOLATE);
				}
			}
			FR09 B 1 Bright {
				A_ZoomFactor(0.99);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.72, SPF_INTERPOLATE);
					A_SetAngle(angle+0.25, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.64, SPF_INTERPOLATE);
					A_SetAngle(angle+0.7, SPF_INTERPOLATE);
				}
			}
			FR09 C 1 Bright {
				A_ZoomFactor(1.0);
			} 
			FR09 D 1 Bright 
			FR05 AAAAAA 1 
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",5,1)
			Goto Reload
			TNT1 A 0
			TNT1 A 0 A_Refire ("HoldFlak")
			Goto Ready3
			
		FireSpear:
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",5,1)
			Goto Reload
			TNT1 A 0 A_Playsound("weapons/freezer/powerup")
			FR10 EEEEEFFFFFFGGGGGGHHHHH 1 
			TNT1 AAAAAAAAAA 0 A_FireCustomMissile("BluePlasmaParticle",random(10,-10),0,0,random(-3,3),0,random(7,-7) )
			
			FR09 EFGH 0 // Initialize sprites into virtual memory
			FR09 E 1 Bright {
				A_GunFlash;
				A_Overlay(-2, "BeamMuzzleFlash");
				A_Takeinventory("CryoRifleAmmo",5);
				A_AlertMonsters(450);
				A_Playsound("weapons/freezer/spearfire");
				A_FireCustomMissile("FreezerSpear", 0, 0, 0, 0);
				A_FireCustomMissile("BlueFlareSpawn",0,0,0,0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				
				A_ZoomFactor(0.98);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.92, SPF_INTERPOLATE);
					A_SetAngle(angle+0.45, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.84, SPF_INTERPOLATE);
					A_SetAngle(angle+0.9, SPF_INTERPOLATE);
				}
			}
			FR09 F 1 Bright {
				A_ZoomFactor(0.99);
				if (CountInv("PowerStrength") >= 1 ) {
				A_SetPitch(pitch-0.92, SPF_INTERPOLATE);
				A_SetAngle(angle+0.45, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.84, SPF_INTERPOLATE);
					A_SetAngle(angle+0.9, SPF_INTERPOLATE);
				}
			}
			FR09 G 1 Bright {
				A_ZoomFactor(1.0);
			} 
			FR09 H 1 Bright 
			FR05 BCDEFG 1 
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",5,1)
			Goto Reload
			TNT1 A 0
			Goto Ready3
		
		Reload:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "ReloadObject")
			TNT1 A 0 {
				A_StopSound(1);
				A_StopSound(6);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",45,"Ready3")
			TNT1 A 0 A_JumpIfInventory("PlasmaAmmo",1,1)
			Goto Ready3
			FR07 ABCDEFGHIJKLMNO 0
			FR08 ZYXWVUTSRQPONMLKJIH 0
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/reload1", "Auto")
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"Reload1Defence")
		Reload1:
			FR07 A 1
			Goto Reload2
		Reload1Defence:
			FR07 B 1
		Reload2:
			FR07 CDEFGHHHHHH 1 
			TNT1 A 0 A_JumpIfInventory("CryoRifleHasUnloaded", 1, "Reload3")
			TNT1 A 0 A_PlaySoundEx("weapons/plasma/cellout", "Auto")
			FR07 IJJJJJ 1 
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/respect3", "Auto")
			FR07 KLMNOOOOO 1 
		Reload3:
			TNT1 A 0 A_PlaySoundEx("weapons/IronSights", "Auto")
			FR07 OOOOONMLK 1 
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/respect1", "Auto")
			FR07 JJIHHGF 1 
			FR08 ZYXWVUTSRQPOUTSRQPONMLKJIH 1
			TNT1 A 0 A_Takeinventory("CryoRifleHasUnloaded", 1)
		InsertBullets:
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",45,"Ready3")
			TNT1 A 0 A_JumpIfInventory("PlasmaAmmo",1,1)
			Goto Ready3
			TNT1 A 0 {
				A_Giveinventory("CryoRifleAmmo",1);
				A_Takeinventory("PlasmaAmmo",1);
				}
			Goto InsertBullets	
		
		Unload:
			TNT1 A 0 {
				A_Takeinventory("Unloading",1);
				A_GiveInventory("CryoRifleHasUnloaded", 1);
				A_StopSound(1);
				A_StopSound(6);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",1,1)
			Goto Ready3
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/reload1", "Auto")
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"Unload1Defence")
		Unload1:
			FR07 A 1
			Goto Unload2
		Unload1Defence:
			FR07 B 1
		Unload2:
			FR07 CDEFGHHHHHH 1 
			TNT1 A 0 A_PlaySoundEx("weapons/plasma/cellout", "Auto")
			FR07 IJJJJJ 1 
			TNT1 A 0 A_PlaySoundEx("weapons/freezer/respect3", "Auto")
			FR07 KLMNOOOOO 1 
		RemoveBullets:
			TNT1 A 0 A_JumpIfInventory("CryoRifleAmmo",1,1)
			Goto FinishUnload
			TNT1 A 0 {
				A_Takeinventory("CryoRifleAmmo",1);
				A_Giveinventory("PlasmaAmmo",1);
			}
			Goto RemoveBullets
		FInishUnload:
			TNT1 A 0 A_PlaySoundEx("weapons/IronSights", "Auto")
			FR07 HGFEDCA 1
			TNT1 A 0 A_Giveinventory("CryoRifleHasUnloaded",1)
			TNT1 A 0 A_Takeinventory("Unloading",1)
			Goto Ready3
	
		Spawn:
			FR11 A 10 
			LOOP
			
		FlashPunching:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashPunchingObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"FlashPunchingDefence")
			FR01 ABCDEEE 1
			FR01 EEEDCBA 1
			Stop
		FlashPunchingDefence:
			FR02 ABCDEEE 1
			FR02 EEEDCBA 1
			Stop

		FlashKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashKickingObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"FlashKickingDefence")
			FR03 ABCDE 1
			FR03 E 4
			FR03 EDCBA 1
			FR05 A 1
			Stop
		FlashKickingDefence:
			FR04 ABCDE 1
			FR04 E 4
			FR04 EDCBA 1
			FR05 B 1
			Stop
		
		FlashAirKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashAirKickingObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"FlashAirKickingDefence")
			FR03 ABCDE 1
			FR03 E 5
			FR03 EDCBA 1
			FR05 A 1
			Stop
		FlashAirKickingDefence:
			FR04 ABCDE 1
			FR04 E 5
			FR04 EDCBA 1
			FR05 B 1
			Stop
		
		FlashSlideKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashSlideKickingObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"FlashSlideKickingDefence")
			FR01 ABCDEEEEEEEEEEEEEEEEEE 1
			Goto FlashSlideKickingStop
		FlashSlideKickingDefence:
			FR02 ABCDEEEEEEEEEEEEEEEEEE 1
			Goto FlashSlideKickingStop
		FlashSlideKickingStop:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashSlideKickingStopObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			TNT1 A 0 A_JumpIfInventory("CryoRifleFireModeDefence",1,"FlashSlideKickingStopDefence")
			FR01 EDCBA 1
			FR05 AA 1
			Stop
		FlashSlideKickingStopDefence:
			FR02 EDCBA 1
			FR05 BE 1
			Stop
	}
}

