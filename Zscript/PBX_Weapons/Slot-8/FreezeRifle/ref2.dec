		TNT1 AAA 0 A_SpawnItemEx ("DetectCeilIce",random(-30,30), random(-30,30),1,0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AAA 0 A_SpawnItemEx ("DetectFloorIce",random(-30,30), random(-30,30),1,0,0,0,0,SXF_NOCHECKPOSITION,0)
	    TNT1 AAAAAA 0 A_SpawnItemEx ("RandomSmallIcecrystal",random(-60,60), random(-60,60),random(1,5),0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AAA 0 A_SpawnItemEx ("RandomMediumIcecrystal",random(-40,40), random(-40,40),random(1,5),0,0,0,0,SXF_NOCHECKPOSITION,0)
		TNT1 AA 0 Bright A_SpawnItemEx("CryoSmoke", 0, 0, 0, random(10, 30)*0.1, 0, random(0, 10)*0.1, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 AA 0 Bright A_SpawnItemEx("CryoSmoke3", 0, 0, 0, random(10, 30)*0.04, 0, random(0, 10)*0.04, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
		TNT1 AAAA 0 Bright A_SpawnItemEx("FreezerTrailSparksSmall", random(5,-5), random(5,-5), random(5,-5), random(10, 30)*0.04, 0, random(0, 10)*0.04, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
		TNT1 A 0 Bright A_SpawnItemEx("CryoSmoke2", 0, 0, 0, random(10, 30)*0.04, 0, random(0, 10)*0.04, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
		TNT1 A 0 Bright A_SpawnItemEx("IceExplosionImpact", 0, 0, 0, 0, 0, 0, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
		TNT1 A 0 A_Playsound("weapons/freezer/missiledeath")
		BXPL ABCDEFGH 1 Bright
		BXPL IJKLLM 1 Bright A_FadeOut(0.1)
		Stop
	}
}

