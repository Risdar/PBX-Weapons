ACTOR FreezerBeam : FastProjectile
{
	Radius 2
	Height 2
	Speed 500
	Damage (60)
	Scale 0.4
	Projectile
	DamageType "freeze"
	RenderStyle Add
	Alpha 0.7
	+NODAMAGETHRUST
	+FORCEXYBILLBOARD
	+FORCERADIUSDMG
	+BLOODLESSIMPACT
	+RANDOMIZE
	+DONTSPLASH
	DeathSound "weapons/cryobowhit"
	MissileType "CryoTrail"
	//MissileHeight 8
	States {
		Spawn:
			BSHT A 1 Bright
			Loop
		Death:	
			TNT1 A 0 A_RadiusGive("IceDamageSlowness",20,RGF_PLAYERS,1)
			TNT1 A 0 Bright A_StopSound(CHAN_BODY)
			TNT1 A 0 Bright A_Jump (160, "realdeath")
			TNT1 AAA 0 Bright A_SpawnItemEx("CryoSmoke", random(-60,60), random(-60,60), random(-10,30), random(10, 30)*0.1, 0, random(0, 10)*0.1, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
			TNT1 AAA 0 Bright A_SpawnItemEx("CryoSmoke3", random(-60,60), random(-60,60), random(-10,30), random(10, 30)*0.04, 0, random(0, 10)*0.04, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
			TNT1 AAA 0 Bright A_SpawnItemEx("FreezerTrailSparksSmall", random(-60,60), random(-60,60), random(-10,30), random(10, 30)*0.04, 0, random(0, 10)*0.04, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
			TNT1 AAA 0 Bright A_SpawnItemEx("CryoSmoke2", random(-40,40), random(-40,40), random(-10,20), random(10, 30)*0.04, 0, random(0, 10)*0.04, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
			TNT1 AAA 0 Bright A_SpawnItemEx("IceExplosionImpact", random(-40,40), random(-40,40), random(-10,20), 0, 0, 0, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("DetectFloorIce",0,0,1,0,0,0,0,128)
			TNT1 A 0 A_SpawnItemEx("DetectCeilIce",0,0,1,0,0,0,0,128)
		realdeath:
			TNT1 A 0 Bright A_ChangeFlag("ICEDAMAGE", 1)
			TNT1 A 0 Bright A_ChangeFlag("NODAMAGETHRUST", 0) 
			TNT1 A 0 Bright A_SpawnItemEx("CryoSmoke2", 0, 0, 0, random(10, 30)*0.04, 0, random(0, 10)*0.04, random(1,360), SXF_CLIENTSIDE|SXF_NOCHECKPOSITION,64)
			TNT1 A 0 Bright A_Explode(15, 20, 0)
			BXPL ABCDEFGH 1 Bright
			BXPL IJKLM 1 Bright A_FadeOut(0.1)
			stop	}}

ACTOR CryoTrail
{
	+FORCEXYBILLBOARD
	+CLIENTSIDEONLY
	+NOBLOCKMAP
	+NOGRAVITY
	+NOTELEPORT
	+CANNOTPUSH
	+NODAMAGETHRUST
	+ROLLSPRITE
	Radius 2
	Height 4
	Renderstyle Add
	Alpha 0.5
	Scale 0.4
	States
	{
		Spawn:
			TNT1 A 0
			X027 A 1 Bright {
			A_Setroll(roll+frandom(-50,50));
			if(A_CheckRange(600,"Null")){ A_Setscale(.15); }
			}
		Looper:
			X027 A 1 Bright {
			A_Setroll(roll+frandom(-50,50));
			if(A_CheckRange(600,"Null")){ A_Setscale(.15); }
			}
			Stop
	}
}
			
