Actor RespectPumpShotgun: Inventory
{
Inventory.maxamount 1
}

Actor PumpShotgunChamberEmpty: Inventory
{
Inventory.maxamount 1
}

Actor PumpShotgunHasUnloaded: Inventory
{
Inventory.maxamount 1
}

Actor PumpShotgunWasEmpty: Inventory
{
Inventory.maxamount 1
}

Actor PumpPumpShotgun: Inventory
{
Inventory.maxamount 1
}

Actor JustFiredPumpShotgun: Inventory
{
Inventory.maxamount 200
}

Actor PumpShotgunMagazineToken: Inventory
{
Inventory.maxamount 200
}

Actor PumpShotgunMagNotInserted: Inventory
{
Inventory.maxamount 200
}

Actor PumpShotgunMagazine: PB_UpgradeItem
{
//$Category Ammunition
	SpawnID 9310
	Game Doom
	Height 24
	+INVENTORY.ALWAYSPICKUP
	+COUNTITEM
	Inventory.Pickupsound "SHOTPICK"
	Inventory.PickupMessage "Pump Shotgun Magazine (Slot 2)"
	Scale 0.45
	States
	{

	Spawn:
		AUSC B 10 Bright 
		LOOP
	
    Pickup:
		TNT1 A 0 ACS_NamedExecuteAlways("PumpShotgunMag", 0)
		TNT1 A 0
		{
		A_GiveInventory("PumpShotgun", 1);
		A_GiveInventory("ShellAmmo", 22);
		A_GiveInventory("PumpShotgunAmmo", 11);
        if (CountInv("PumpShotgunMagazineToken") == 0) {A_GiveInventory("PumpshotgunMagNotInserted", 1);}
		A_GiveInventory("PumpShotgunMagazineToken", 1);
		}
		Stop
	}
}

ACTOR PumpShotgun : PB_Weapon
{
	Weapon.BobRangeX 0.3
	Weapon.BobRangeY 0.5
	Weapon.BobStyle InverseSmooth
	Weapon.BobSpeed 2.4
	Game Doom
	Weapon.SelectionOrder 1300
	Weapon.AmmoUse1 0
	Weapon.AmmoUse2 0
	Weapon.AmmoGive1 18
	Weapon.AmmoGive2 9
	+FLOORCLIP
	+DONTGIB
	Scale 0.45
	Weapon.AmmoType1 "ShellAmmo"
	Weapon.AmmoType2 "PumpShotgunAmmo"
	Inventory.PickupMessage "Pump Shotgun (Slot 2)"
	Inventory.PickupSound "weapons/sgpump"
	Inventory.Icon "AUSCA0"
	Damagetype "Shotgun"
	Inventory.Amount 1
	Inventory.MaxAmount 3
	Obituary "%k Opened %o with a Pump Shotgun"
	AttackSound "None"
	Tag "Pump Shotgun"
	+WEAPON.NOALERT
	+WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	PB_WeaponBase.UnloaderToken "PumpShotgunHasUnloaded"
	States
	{
		Steady:
			TNT1 A 1
			Goto Ready
			
		Ready:
			TNT1 A 0 {	
				A_Takeinventory("Unloading",1);
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
				A_ZoomFactor(1.0);
			}
			AU10 ABCDEFGH 0 
			TNT1 A 0 A_JumpIfInventory("RespectPumpShotgun", 1, "SelectAnimation")
		Respect:
			"####" "#" 0 A_GiveInventory("RespectPumpShotgun")
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
			TNT1 A 0 {
				A_SetCrosshair(5);
				A_Giveinventory("PB_LockScreenTilt",1);
			}
			TNT1 A 0 {
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
			}
			TNT1 AAAAAA 1 {
				A_SetRoll(roll-0.3,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			AG10 A 1 {
				A_SetRoll(roll-0.3,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_PlaysoundEx("weapons/autoshotgun/respect1", "Auto")
			AG10 BCDEFGH 1 {
				A_SetRoll(roll+0.3,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 {
				A_Giveinventory("PB_LockScreenTilt",1);
				A_PlaysoundEx("Ironsights", "Auto");
			}
			AG31 ABCD 1 {
				A_SetRoll(roll+1.0,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_PlaySoundEx("weapons/sgmvpump","Auto")
			AG31 EF 1 {
				A_SetRoll(roll-2.0,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			AG31 GHIJKL 1 {
				A_SetRoll(roll-1.0,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			AG31 M 1 A_DoPBWeaponAction
			AG31 N 1 {
				A_PlaySoundEx("insertshell","Auto");
				A_DoPBWeaponAction;
			}
			AG31 OP 1 A_DoPBWeaponAction
			AG31 Q 1 {
				A_PlaySoundEx("weapons/sgpump","Auto");
				A_Takeinventory("PumpShotgunWasEmpty", 1);
				A_Takeinventory("PumpShotgunHasUnloaded",1);
				A_TakeInventory("PumpPumpShotgun", 1);
				A_TakeInventory("PumpShotgunChamberEmpty", 1);
				A_DoPBWeaponAction;
			}
			AG31 RSTU 1 A_DoPBWeaponAction
			AG40 HHHHHHHHH 1 A_DoPBWeaponAction
			TNT1 A 0 {
				A_PlaysoundEx("H4SGCOCK", "Auto");
				A_TakeInventory("PumpPumpShotgun", 1);
				A_TakeInventory ("PumpShotgunChamberEmpty",1);
			}
			AG40 IJKL 1 {
				A_SetRoll(roll-0.3,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			AG40 LLL 1 A_DoPBWeaponAction
			AG40 MNH 1 {
				A_SetRoll(roll+0.4,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			AG40 HG 1
			AG40 FEDCBA 1 {
				A_SetRoll(roll+1.0,SPF_INTERPOLATE);
				A_DoPBWeaponAction;
			}
			TNT1 A 0 A_JumpIfInventory("PumpshotgunMagNotInserted", 1, "InsertMagBegin")
			TNT1 A 0 A_Takeinventory("PB_LockScreenTilt",1)
			Goto Ready3
			
		InsertMagBegin: // Straight Into Inserting The Mag After Chambering a shell. 
			TNT1 A 0 A_TakeInventory("PumpshotgunMagNotInserted",1)
			TNT1 A 0 A_GiveInventory("PumpShotgunAmmo",10)
			TNT1 A 0 A_GiveInventory("PumpShotgunMagazineToken",1)
			AG30 A 1 A_DoPBWeaponAction(WRF_NOBOB)
			AG30 BCDEFGHIJKL 1 {
			A_DoPBWeaponAction(WRF_NOBOB);
			return state("");
			}
		BeginInsertion:	
			AG30 L 1 A_DoPBWeaponAction(WRF_NOBOB)
			TNT1 A 0 A_PlaySound("IronSights", 3)
			AG3M QRSNMLKJ 1 A_DoPBWeaponAction(WRF_NOBOB)
			TNT1 A 0 A_PlaySound("insertshell", 4)
			TNT1 A 0 A_PlaySound("RIFCL_CL", 5)
			AG3M IHGFEDCBA 1 A_DoPBWeaponAction(WRF_NOBOB)
			TNT1 A 0 A_JumpIfInventory("PumpShotgunMagazineToken", 2, "Ready3")
			Goto Ready3
		InsertMagShotgunRespectAlreadyRespected:
			TNT1 A 0 A_TakeInventory("PumpshotgunMagNotInserted",1)
			TNT1 A 0 A_GiveInventory("PumpShotgunAmmo",10)
			TNT1 A 0 A_GiveInventory("PumpShotgunMagazineToken",1)
			AG30 A 1 A_DoPBWeaponAction(WRF_NOBOB)
			AG30 BCDEFGHIJKL 1 {
			A_DoPBWeaponAction(WRF_NOBOB);
			return state("");
			}
			Goto BeginInsertion
			
		SelectAnimationMagazine:
			TNT1 A 0 A_PlaySoundEx("weapons/autoshotgun/respect1", "Auto")
			TNT1 A 0 {
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
			}
			AG10 IJCDEFG 1
			Goto Ready3
		SelectAnimation:
			TNT1 A 0 A_PlaySoundEx("weapons/autoshotgun/respect1", "Auto")
			TNT1 A 0 {
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
			}
			TNT1 A 0 A_JumpIfInventory("PumpShotgunMagazineToken", 1, "SelectAnimationMagazine")
			AG10 ABCDEFG 1

		Ready3:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunChamberEmpty", 1, "Pump")
			TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Ready2")
			TNT1 A 0 A_JumpIfInventory("ADSMode", 1, "Ready2")
			TNT1 A 0 {
				A_ClearOverlays(10,11);
				A_SetRoll(0);
				A_SetCrosshair(46);
				A_TakeInventory("PB_LockScreenTilt",1);
			}
		ReadyToFire:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunChamberEmpty", 1, "Pump")
			TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "ReadyToFire2")
			TNT1 A 0 A_JumpIfInventory("ADSMode", 1, "ReadyToFire2")
			AG10 H 1 {
					if (CountInv("PumpshotgunMagNotInserted") >= 1 ) { return state("InsertMagShotgunRespectAlreadyRespected"); }
					if (CountInv("PumpPumpShotgun") == 1 && CountInv("PumpShotgunAmmo") >= 1) {return state("Pump");}
					return A_DoPBWeaponAction(WRF_ALLOWRELOAD, CheckUnloaded("PumpShotgunHasUnloaded"));
					if (PressingFire() && PressingAltfire() && CountInv("PumpShotgunAmmo") > 0){
							return state("Fire");
					}
					if (PressingFire() && CountInv("PumpShotgunAmmo") > 0){
							return state("Fire");
					}
					return A_DoPBWeaponAction(WRF_ALLOWRELOAD, CheckUnloaded("PumpShotgunHasUnloaded"));	 
				}
			Loop
		Ready2:
		"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
		TNT1 A 0 A_JumpIfInventory("PumpShotgunChamberEmpty", 1, "Pump2")
		ASS1 E 1 {
			//Updated code for far superior smooth gameplay
			if(GetCvar("pb_toggle_aim_hold")) {
				if(!PressingAltfire() || JustReleased(BT_ALTATTACK)){
					return state("Zoomout");
				}
		
				if (PressingFire() && PressingAltfire() && CountInv("PumpShotgunAmmo") > 0){
						return state("Fire2");
				}
				
				
				return A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE);
				
			}
			else {
				if (PressingFire() && CountInv("PumpShotgunAmmo") > 0){
					return state("Fire2");
				}
				return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
			}
			return state("");
		}
		Loop
			
		WeaponSpecial:
			"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "WeaponSpecialObject")
			TNT1 A 0 {
				A_Takeinventory("GoWeaponSpecialAbility",1);
				A_GiveInventory("PB_LockScreenTilt",1);
				A_SetCrosshair(46);
				A_ClearOverlays(10,11);
			}
			Goto Ready3
		
		Deselect:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "DeselectObject")
			TNT1 A 0 {
				A_SetRoll(0);
				A_SetCrosshair(46);
				A_TakeInventory("PB_LockScreenTilt",1);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 {	
				A_Takeinventory("Unloading",1);
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
				 A_Takeinventory("RandomHeadExploder",1);
				A_ZoomFactor(1.0);
			}
			AG10 FEDCBA 1
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
			Wait

		Select:
			TNT1 A 0 {
				A_SetRoll(0);
				A_SetCrosshair(46);
				A_TakeInventory("PB_LockScreenTilt",1);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_Takeinventory("Unloading",1)
			TNT1 A 0 A_Overlay(-10, "FirstPersonLegsStand")
			TNT1 A 0 A_Giveinventory("RandomHeadExploder",1)
			TNT1 A 0 A_Takeinventory("HitboxFireDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxIceDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxAcidDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxPlasmaDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxDemonicDamage",1)
			TNT1 A 0 A_Takeinventory("HitboxBladedDamage",1)
			TNT1 A 0 A_TakeInventory("BlasterPistolSelected",1)
			TNT1 A 0 A_TakeInventory("TacticalPistolSelected",1)
			TNT1 A 0 A_TakeInventory("MagnumSelected",1)
			TNT1 A 0 A_TakeInventory("DesertEagleSelected",1)
			TNT1 A 0 A_GiveInventory("PumpShotgunSelected",1)
			TNT1 A 0 A_TakeInventory("SlugShotgunSelected",1)
			TNT1 A 0 A_TakeInventory("LeverActionSelected",1)
			TNT1 A 0 A_TakeInventory("DoubleBarrelShotgunSelected",1)
			TNT1 A 0 A_TakeInventory("QuadBarrelShotgunSelected",1)
			TNT1 A 0 A_TakeInventory("SubMachineGunSelected",1)
			TNT1 A 0 A_TakeInventory("MP40Selected",1)
			TNT1 A 0 A_TakeInventory("AssaultRifleSelected",1)
			TNT1 A 0 A_TakeInventory("LightMachineGunSelected",1)
			TNT1 A 0 A_TakeInventory("SniperSelected",1)
			TNT1 A 0 A_TakeInventory("DMRSelected",1)
			TNT1 A 0 A_TakeInventory("MiniGunSelected",1)
			TNT1 A 0 A_TakeInventory("NailgunSelected",1)
			TNT1 A 0 A_TakeInventory("MG42Selected",1)
			TNT1 A 0 A_TakeInventory("ThumperSelected",1)
			TNT1 A 0 A_TakeInventory("GuidedRocketLauncherSelected",1)
			TNT1 A 0 A_TakeInventory("ExcavatorSelected",1)
			TNT1 A 0 A_TakeInventory("M1PlasmaRifleSelected",1)
			TNT1 A 0 A_TakeInventory("M2PlasmaRifleSelected",1)
			TNT1 A 0 A_TakeInventory("CryoRifleSelected",1)
			TNT1 A 0 A_TakeInventory("FlamerSelected",1)
			TNT1 A 0 A_TakeInventory("RailGunSelected",1)
			TNT1 A 0 A_TakeInventory("BigFuckingGunSelected",1)
			TNT1 A 0 A_TakeInventory("BallistaSelected",1)
			TNT1 A 0 A_TakeInventory("DemonicRifleSelected",1)
			TNT1 A 0 A_TakeInventory("FrostburnDeviceSelected",1)
			TNT1 A 0 A_TakeInventory("HasFlare",1)
			TNT1 A 0 A_TakeInventory("HasQuickLauncher",1)
			TNT1 A 0 A_TakeInventory("HasBarrel",1)
			TNT1 A 0 A_TakeInventory("HasIceBarrel", 1)
			TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
			TNT1 A 0 A_TakeInventory("EquippedObject",1)
			TNT1 A 0 {
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
			}
			TNT1 A 0 {
				if( CountInv ("RadSuitOn") >= 1 ) {
					A_overlay(800,"WearingRadSuit",false);
					A_overlayflags(800, PSPF_ADDBOB, false);
					A_overlayflags(800, PSPF_ALPHA | PSPF_RENDERSTYLE, true);
					A_OverlayRenderstyle(800,STYLE_Translucent);
					A_overlayalpha(800,0.8);
				}
			}
			TNT1 AAAAAAAAAAAAAAAAAA 0 A_Raise
			TNT1 AAAAAAAA 1 A_Raise
			Wait
		
		Fire:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "PrimaryFireObject")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",1,1)
			Goto Reload
			TNT1 A 0
			TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
			TNT1 A 0 A_JumpIfInventory("ADSMode",1,"Fire2")
			TNT1 A 0 {
				A_SetRoll(0);
				A_SetCrosshair(46);
				A_TakeInventory("PB_LockScreenTilt",1);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("PumpShotgunMagazineToken", 1, "DrumFire")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunWasEmpty", 1, "Pump")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunChamberEmpty", 1, "Pump")
			TNT1 A 0 A_FireBullets (frandom(6.84,7.45), frandom(6.75,7.25), 8, 6, "ShotgunPuff")
			TNT1 A 0 A_FireBullets (frandom(4.85,3.65), frandom(2.32,3.75), 5, 10, "ShotgunPuff")
			TNT1 A 0 A_GiveInventory ("PumpShotgunChamberEmpty",1)
			AG20 A 1 BRIGHT {
				A_Takeinventory("PumpShotgunAmmo",1);
				A_AlertMonsters;
				A_PlaySoundeX("Weapons/Autoshotgun", "Weapon");
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0);
				A_FireCustomMissile("YellowFlareSpawn",0,0,0,0);
				A_Giveinventory("JustFiredPumpShotgun",20);
				A_GunFlash;
				A_ZoomFactor(0.98);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.82, SPF_INTERPOLATE);
					A_SetAngle(angle+0.44, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.64, SPF_INTERPOLATE);
					A_SetAngle(angle+0.88, SPF_INTERPOLATE);
				}
			}
			AG20 B 1 BRIGHT {
				
				A_ZoomFactor(0.99);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.82, SPF_INTERPOLATE);
					A_SetAngle(angle+0.44, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.64, SPF_INTERPOLATE);
					A_SetAngle(angle+0.88, SPF_INTERPOLATE);
				}
			}
			AG20 C 1 {
				A_ZoomFactor(1.0);
				A_FireCustomMissile("ShotCaseSpawn",0,0,4,-8);
			}
			AG20 DEFGHHH 1 
			AG20 I 1 
			TNT1 A 0 {
			A_Takeinventory("Zoomed",1);
			A_Takeinventory("ADSmode",1);
			}
			Goto Pump
			
		Fire2:
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo", 1, 1)
			Goto Reload
			TNT1 A 0
			TNT1 A 0 {
				A_SetRoll(0);
				A_SetCrosshair(5);
				A_TakeInventory("PB_LockScreenTilt",1);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",1,1)
			Goto Reload
			TNT1 A 0 A_JumpIfInventory("PumpShotgunWasEmpty", 1, "Pump")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunChamberEmpty", 1, "Pump")
			TNT1 A 0 A_FireBullets (frandom(5.84,6.45), frandom(5.75,6.25), 8, 6, "ShotgunPuff")
			TNT1 A 0 A_FireBullets (frandom(3.85,2.65), frandom(1.32,2.75), 6, 10, "ShotgunPuff")
			TNT1 A 0 A_GiveInventory ("PumpShotgunChamberEmpty",1)
			ASX1 A 1 BRIGHT {
				A_Takeinventory("PumpShotgunAmmo",1);
				A_AlertMonsters;
				A_PlaySoundeX("Weapons/Autoshotgun", "Weapon");
				A_FireCustomMissile("GunFireSmoke", 0, 0, 0, 1, 0, 0);
				A_FireCustomMissile("ShakeYourAssDouble", 0, 0, 0, 0);
				A_FireCustomMissile("YellowFlareSpawn",0,0,0,0);
				A_Giveinventory("JustFiredPumpShotgun",20);
				A_GunFlash;
				A_ZoomFactor(1.48);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.62, SPF_INTERPOLATE);
					A_SetAngle(angle+0.24, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.64, SPF_INTERPOLATE);
					A_SetAngle(angle+0.68, SPF_INTERPOLATE);
				}
			}
			ASX1 B 1 BRIGHT {
				
				A_ZoomFactor(1.49);
				if (CountInv("PowerStrength") >= 1 ) {
					A_SetPitch(pitch-0.62, SPF_INTERPOLATE);
					A_SetAngle(angle+0.24, SPF_INTERPOLATE);
				}
				else {
					A_SetPitch(pitch-1.44, SPF_INTERPOLATE);
					A_SetAngle(angle+0.68, SPF_INTERPOLATE);
				}
			}
			ASX1 C 2 
			ASX1 D 2 
			TNT1 A 0 {
			//Updated code for far superior smooth gameplay
			if(GetCvar("pb_toggle_aim_hold")) {
				if(!PressingAltfire() || JustReleased(BT_ALTATTACK)){
					return state("PrepareToPump");
				}
		
				if (PressingFire() && PressingAltfire() && CountInv("PumpShotgunAmmo") > 0){
						return state("Pump2");
				}
				
				
				return A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE);
				
			}
			else {
				if (PressingFire() && CountInv("PumpShotgunAmmo") > 0){
					return state("Pump2");
				}
				return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
			}
			return state("");
		}
			Goto Pump2
		
		AltFire:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "AltFireObject")
			TNT1 A 0 A_JumpIfInventory ("PumpShotgunChamberEmpty", 1, "Pump")
			TNT1 A 0 {
				A_SetRoll(0);
				A_SetCrosshair(46);
				A_TakeInventory("PB_LockScreenTilt",1);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_StartSound("IronSights", 0)
			TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Zoomout")
			TNT1 A 0 A_ZoomFactor(1.5)
			ASS1 ABC 1
			TNT1 A 0 {
			A_Giveinventory("Zoomed",1);
			A_Giveinventory("ADSmode",1);
			A_SetCrosshair(5);
			A_WeaponReady(WRF_NOSECONDARY);
			}
			Goto Ready2
			
		Zoomout:
			TNT1 A 0 {	
				A_SetCrosshair(46);
				A_ZoomFactor(1.0);
				}
			ASS1 CBA 1
			TNT1 A 0 {	
				A_Takeinventory("Zoomed",1);
				A_Takeinventory("ADSmode",1);
				}
			TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
			TNT1 A 0 A_JumpIfInventory ("PumpShotgunChamberEmpty", 1, "Pump")
			Goto Ready3
			
		Pump:
			TNT1 A 0 A_JumpIfInventory("PumpShotgunMagazineToken", 1, "PumpMagazine")
			TNT1 A 0 {
			A_ZoomFactor(1.0);
			A_Giveinventory("PB_LockScreenTilt",1);
			A_TakeInventory("Zoomed",1);
			A_TakeInventory("ADSMode",1);
			A_SetCrosshair(5);
			A_PlaySoundEx("Ironsights", "Auto");
			}
			TNT1 A 0 A_JumpIfInventory("PumpShotgunMagazineToken", 1, "DrumPump")
			AG40 ABCDEFGH 1 A_SetRoll(roll-0.1,SPF_INTERPOLATE)
			TNT1 A 0 {
				A_PlaysoundEx("H4SGCOCK", "Auto");
				A_TakeInventory("PumpPumpShotgun", 1);
				A_TakeInventory ("PumpShotgunChamberEmpty",1);
			}
			AG40 IJKL 1 A_SetRoll(roll-0.3,SPF_INTERPOLATE)
			AG40 LLL 1 
			TNT1 A 0 A_FireCustomMissile("ShotCaseSpawn",0,0,-2,-18)
			AG40 MNH 1 A_SetRoll(roll+0.4,SPF_INTERPOLATE)
			AG40 HGFEDCBA 1 A_SetRoll(roll+0.1,SPF_INTERPOLATE)
			TNT1 A 0 
			TNT1 A 0 A_refire
			Goto Ready3
			
	PumpMagazine:
			TNT1 A 0 {
			A_ZoomFactor(1.0);
			A_Giveinventory("PB_LockScreenTilt",1);
			A_TakeInventory("Zoomed",1);
			A_TakeInventory("ADSMode",1);
			A_SetCrosshair(5);
			A_PlaySoundEx("Ironsights", "Auto");
			}
			AG40 ABCDE 1 A_SetRoll(roll-0.1,SPF_INTERPOLATE)
			AG4M ABC 1 A_SetRoll(roll-0.1,SPF_INTERPOLATE)
			TNT1 A 0 {
				A_PlaysoundEx("H4SGCOCK", "Auto");
				A_TakeInventory("PumpPumpShotgun", 1);
				A_TakeInventory ("PumpShotgunChamberEmpty",1);
			}
			AG4M DEFG 1 A_SetRoll(roll-0.3,SPF_INTERPOLATE)
			AG4M GGG 1 A_SetRoll(roll+0.1,SPF_INTERPOLATE)
			TNT1 A 0 A_FireCustomMissile("ShotCaseSpawn",0,0,-2,-18)
			AG4M HIC 1 A_SetRoll(roll+0.4,SPF_INTERPOLATE)
			AG4M BA 1 A_SetRoll(roll+0.1,SPF_INTERPOLATE)
			AG10 HHH 1 A_SetRoll(roll+0.1,SPF_INTERPOLATE)
			TNT1 A 0 
			TNT1 A 0 A_refire
			Goto Ready3
		
	Pump2:
		TNT1 A 0 {
			A_ZoomFactor(1.5);
			A_Giveinventory("PB_LockScreenTilt",1);
			A_SetCrosshair(5);
			}
		ASS2 A 5
	    TNT1 A 0 A_PlaySoundEx("H4SGCOCK", "Auto")
		ASS2 BCD 1
		TNT1 A 0 A_FireCustomMissile("ShotCaseSpawn",0,0,4,-7)	 
		ASS2 DDDDCBA 1 
		ASS2 A 2 
		TNT1 A 0 A_TakeInventory ("PumpShotgunChamberEmpty",1)
		TNT1 A 0 {
		if(GetCvar("pb_toggle_aim_hold")) {
			if(JustReleased(BT_ALTATTACK)){
				return state("Zoomout");
			}
	
			if (JustPressed(BT_ATTACK) && PressingAltfire()){
					return state("Fire2");
			}
		}
		else {
			if(PressingAltfire()){
				return state("Zoomout");
			}
			
			if (JustPressed(BT_ATTACK)){
					return state("Fire2");
			}
			A_Refire("Fire2");
		}
		return A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOFIRE);
	}
		TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",1,1)
		Goto Reload
		TNT1 A 0
		 Goto Ready2
		
		Reload:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "ReloadObject")
			TNT1 A 0 {
			A_Takeinventory("Zoomed",1);
			A_Takeinventory("ADSmode",1);
			A_ZoomFactor(1.0);
			A_Giveinventory("PB_LockScreenTilt",1);
			A_SetCrosshair(5);
			A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("PumpShotgunMagazineToken", 1, "MagazineReload")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo", 9, "Ready3")
			TNT1 A 0 A_PlaySoundEx("Ironsights", "Auto")
			TNT1 A 0 A_JumpIfInventory("ShellAmmo", 1, "ReloadAnimation")
			TNT1 A 0 A_PlaySoundEx("weapons/empty", "Weapon")
			Goto Ready3
		ReloadAnimation:
			TNT1 A 0 {
				if (CountInv("PumpShotgunAmmo") < 1) {
					return state("EmptyReload");
				}
				return state("");
			}
			Goto BeginNormalReload
		EmptyReload:
			TNT1 A 0 {
				A_Giveinventory("PB_LockScreenTilt",1);
				A_PlaysoundEx("Ironsights", "Auto");
			}
			AG31 ABCD 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			TNT1 A 0 A_PlaySoundEx("weapons/sgmvpump","Auto")
			AG31 EF 1 A_SetRoll(roll-2.0,SPF_INTERPOLATE)
			AG31 GHIJKL 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
			AG31 M 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
			AG31 N 1 {
				A_PlaySoundEx("insertshell","Auto");
				A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE);
			}
			AG31 OP 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
			AG31 Q 1 {
				A_PlaySoundEx("weapons/sgpump","Auto");
				A_Giveinventory("PumpShotgunAmmo",1);
				A_Takeinventory("ShellAmmo",1);
				A_TakeInventory("PumpPumpShotgun", 1);
				A_Takeinventory("PumpShotgunWasEmpty", 1);
				A_Takeinventory("PumpShotgunHasUnloaded",1);
				A_TakeInventory("PumpShotgunChamberEmpty", 1);
				A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE);
			}
			AG31 RSTUV 1 A_DoPBWeaponAction(WRF_NOBOB|WRF_NOFIRE)
			Goto NormalReload
		BeginNormalReload: 
			AG30 ABCD 1 A_SetRoll(roll+1.0,SPF_INTERPOLATE)
			AG30 EF 1 A_SetRoll(roll-2.0,SPF_INTERPOLATE)
			AG30 GHIJKL 1 A_SetRoll(roll-1.0,SPF_INTERPOLATE)
		NormalReload:
			TNT1 A 0 A_JumpIf(CountInv("ShellAmmo") == 0,"ReloadFinished")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",9,"ReloadFinished")
			TNT1 A 0
			AG30 L 3 A_DoPBWeaponAction(WRF_NOBOB)
			AG30 MN 1 A_DoPBWeaponAction(WRF_NOBOB)
			AG30 O 1 { 
				A_PlaySoundEx("insertshell","Auto");
				A_Giveinventory("PumpShotgunAmmo",1);
				A_Takeinventory("ShellAmmo",1);
				A_Takeinventory("PumpShotgunWasEmpty", 1);
				A_SetPitch(pitch-0.2,SPF_INTERPOLATE);
				A_SetAngle(angle+0.2, SPF_INTERPOLATE);
				A_SetRoll(roll-0.4,SPF_INTERPOLATE);
			}
			AG30 PQ 1 {
				A_DoPBWeaponAction(WRF_NOBOB);
				A_SetPitch(pitch+0.1,SPF_INTERPOLATE);
            A_SetAngle(angle-0.1, SPF_INTERPOLATE);
				A_SetRoll(roll+0.2,SPF_INTERPOLATE);
			}
			Loop
		ReloadFinished:
			TNT1 A 0 {
				A_Takeinventory("PB_LockScreenTilt",1);
				A_PlaysoundEx("Ironsights", "Auto");
			}
			AG30 LKJIHG 1 {
				A_DoPBWeaponAction(WRF_NOBOB);
				A_SetRoll(roll+1.0,SPF_INTERPOLATE);
			}
			AG30 FEDCBA 1 A_DoPBWeaponAction(WRF_NOBOB)
			Goto Ready3
		
	MagazineReload:
		TNT1 A 0 A_JumpIfInventory("PumpShotgunWasEmpty", 1, "MagazineReloadFromUnload")
		TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",11,"Ready3")
		TNT1 A 0 A_JumpIf(CountInv("ShellAmmo") == 0,"NoAmmo")
		AG30 ABCD 1 A_SetRoll(roll-0.1,SPF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("PumpShotgunHasUnloaded",1,5)
		AG3M ABCD 1 A_SetRoll(roll-0.1,SPF_INTERPOLATE)
		AG3M EFGH 1
	ActuallyBeginMagReload:	
	    TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",11,"Ready3")
		AG3M IJKLMN 1
		TNT1 A 0 A_PlaySoundEx("RIFCL_OU", "Auto")
		TNT1 A 0 A_PlaySoundEx("weapons/smg_clipout", "Auto")
		TNT1 A 0 A_JumpIf(CountInv("PumpShotgunAmmo") <= 1,"EmptyMagReload")
		AG3M NSRQ 1 
		AG30 LLLL 1
		goto InsertMag	
	EmptyMagReload:
		AG3M NOPQ 1
		AG30 LLLL 1
		TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",1,2)
		TNT1 A 0 A_FireCustomMissile("EmptyClipMP40",-5,0,8,-4)
	InsertMag:
	    AG30 LLLL 1
	    AG3M QRSN 1 
		AG3M M 1 A_PlaySoundEx("RIFCL_IN", "Auto")
		AG3M L 1 A_PlaySoundEx("insertshell", "Auto")
        AG3M KJIHGFE 1 
		TNT1 A 0 A_JumpIf(CountInv("PumpShotgunAmmo") == 0,"ShellCheckerMag2")
	ShellCheckerMag:	
		TNT1 A 0 A_JumpIf(CountInv("ShellAmmo") == 0,"ReloadMagFinished")
		TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",11,"ReloadMagFinished")
		TNT1 A 0 
		{
		 A_Giveinventory("PumpShotgunAmmo",1);
		 A_Takeinventory("ShellAmmo",1);
		}
		Goto ShellCheckerMag
	ShellCheckerMag2:	
		TNT1 A 0 A_JumpIf(CountInv("ShellAmmo") == 0,"LoadChamberMag")
		TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",10,"LoadChamberMag")
		TNT1 A 0 
		{
		 A_Giveinventory("PumpShotgunAmmo",1);
		 A_Takeinventory("ShellAmmo",1);
		}
		Goto ShellCheckerMag2
	LoadChamberMag:
		TNT1 A 0 {
			A_PlaysoundEx("H4SGCOCK", "Auto");
			A_TakeInventory("PumpPumpShotgun", 1);
			A_TakeInventory ("PumpShotgunChamberEmpty",1);
		}
		AG4M DEFG 1 A_SetRoll(roll-0.3,SPF_INTERPOLATE)
		AG4M GGG 1
		AG4M HIC 1 A_SetRoll(roll+0.4,SPF_INTERPOLATE)
		TNT1 A 0 
	ReloadMagFinished:
	    AG3M DCBA 1
		AG30 DCBA 1
		TNT1 A 0
		{
		 A_Takeinventory("Reloading",1);
		 A_Takeinventory("PB_LockScreenTilt",1);
		 A_Takeinventory("PumpShotgunHasUnloaded",1);
		 A_SetRoll(0,SPF_INTERPOLATE);
		}
		TNT1 A 0 A_Refire
		Goto Ready3
		
	MagazineReloadFromUnload:
		TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",11,"Ready3")
		TNT1 A 0 A_JumpIf(CountInv("ShellAmmo") == 0,"NoAmmo")
		AG30 ABCD 1 A_SetRoll(roll-0.1,SPF_INTERPOLATE)
		TNT1 A 0 A_JumpIfInventory("PumpShotgunHasUnloaded",1,5)
		AG30 EFGH 1 A_SetRoll(roll-0.1,SPF_INTERPOLATE)
		AG30 IJKL 1
	    AG30 LLLL 1
	    AG3M QRSN 1 
		AG3M M 1 A_PlaySoundEx("RIFCL_IN", "Auto")
		AG3M L 1 A_PlaySoundEx("insertshell", "Auto")
        AG3M KJIHGFE 1 
		TNT1 A 0 {
			A_Takeinventory("PumpShotgunWasEmpty", 1);
			A_Takeinventory("PumpShotgunHasUnloaded",1);
		}
		Goto ShellCheckerMag2
		
		NoAmmo:
			TNT1 A 0 {
			A_PlaySoundEx("weapons/empty", "Weapon");
			A_TakeInventory("Zoomed", 1);
			A_TakeInventory("ADSmode", 1);
			A_TakeInventory("Reloading", 1);
			A_ZoomFactor(1.0);
			}
			Goto Ready3
		
		Unload:
			TNT1 A 0 {
				A_Giveinventory("PB_LockScreenTilt",1);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				A_Takeinventory("Unloading",1);
				A_GiveInventory("PumpShotgunWasEmpty", 1);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("PumpShotgunMagazineToken", 1, "UnloadMagazine")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",1,1)
			Goto Ready3
			AG40 ABCDEFGH 1 A_DoPBWeaponAction
		RemoveBullets:
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",1,1)
			Goto FinishUnload
			TNT1 A 0 {
				A_Takeinventory("PumpShotgunAmmo",1);
				A_Giveinventory("ShellAmmo",1);
				A_PlaysoundEx("H4SGCOCK", "Weapon");
			}
			AG40 IJKLLLL 1 A_DoPBWeaponAction
			AG40 MN 1 A_DoPBWeaponAction
			Goto RemoveBullets
		FInishUnload:
			AG40 IHGFEDCBA 1 A_DoPBWeaponAction
			TNT1 A 0 A_Giveinventory("PumpShotgunWasEmpty",1)
			TNT1 A 0 A_Takeinventory("Unloading",1)
			Goto Ready3
			
		UnloadMagazine:
			TNT1 A 0 {
				A_Giveinventory("PB_LockScreenTilt",1);
				A_WeaponOffset(0,32);
				A_PlaysoundEx("Ironsights", "Auto");
				A_Takeinventory("Unloading",1);
				A_GiveInventory("PumpShotgunWasEmpty", 1);
				A_ClearOverlays(10,11);
			}
			TNT1 A 0 A_JumpIfInventory("PumpShotgunMagazineToken", 1, "DrumUnload")
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",1,1)
			Goto Ready3
			AG30 ABCD 1 A_DoPBWeaponAction
			AG3M ABCDEFGH 1 A_DoPBWeaponAction
			AG3M IJKLMN 1
			TNT1 A 0 A_PlaySoundEx("RIFCL_OU", "Auto")
			TNT1 A 0 A_PlaySoundEx("weapons/smg_clipout", "Auto")
		RemoveBulletsMagazine:
			TNT1 A 0 A_JumpIfInventory("PumpShotgunAmmo",1,1)
			Goto FinishUnloadMagazine
			TNT1 A 0 {
				A_Takeinventory("PumpShotgunAmmo",1);
				A_Giveinventory("ShellAmmo",1);
			}
			Goto RemoveBulletsMagazine
		FInishUnloadMagazine:
			AG3M NOPQ 1 
			AG30 LKJIHGFEDCBA 1 A_DoPBWeaponAction
			TNT1 A 0 A_Giveinventory("PumpShotgunWasEmpty",1)
			TNT1 A 0 A_Takeinventory("Unloading",1)
			Goto Ready3
	
		Spawn:
			AUSC A 10 
			LOOP
			
		FlashPunching:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashPunchingObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			TNT1 A 0 A_JumpIf(CountInv("PumpShotgunMagazineToken") >=1 && CountInv("PumpShotgunHasUnloaded") != 1, "FlashPunchingMagazine")
			AG51 ABCDEFG 1
			AG51 GFEDCBA 1
			Stop
			
		FlashPunchingMagazine:
			AG51 AB 1
			AG5M ABCDE 1
			AG5M EDCBA 1
			AG51 BA 1
			Stop

		FlashKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashKickingObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			AG50 ABCDEF 1
			AG50 G 2
			AG50 FEDCBA 1
			AG10 G 1
			Stop
		
		FlashAirKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashAirKickingObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			AG50 ABCDEF 1
			AG50 G 3
			AG50 FEDCBA 1
			AG10 G 1
			Stop
		
		FlashSlideKicking:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashSlideKickingObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			AG50 ABCDEF 1
			AG50 G 14
			AG50 FEDCBA 1
			AG10 G 1
			Goto FlashSlideKickingStop
		FlashSlideKickingStop:
			TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashSlideKickingStopObject")
			TNT1 A 0 A_ClearOverlays(10,11)
			AG50 FEDCBA 1
			AG10 G 1
			Stop

	}
}

ACTOR PumpShotgunAmmo : Ammo
{
   Inventory.Amount 0
   Inventory.MaxAmount 9
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 9
   Inventory.Icon "AUSCA0"
}