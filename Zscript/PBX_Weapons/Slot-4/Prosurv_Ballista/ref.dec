/////TOKENS//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
ACTOR RespectBallista : Inventory { Inventory.MaxAmount 1 }
ACTOR SwapToDemonicMode : Inventory { Inventory.MaxAmount 1 }
ACTOR BallistaUnloaded : Inventory { Inventory.MaxAmount 1 }
ACTOR BallistaUpgraded : Inventory { Inventory.MaxAmount 1 }
ACTOR BallistaBoltMode : Inventory { Inventory.MaxAmount 1 }
ACTOR BallistaExplosiveMode : Inventory { Inventory.MaxAmount 1 }
ACTOR BallistaDemonicMode : Inventory { Inventory.MaxAmount 1 }

/////WEAPON//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
ACTOR Ballista : PB_weapon {
	Game Doom
	Weapon.AmmoUse1 0
	Weapon.AmmoGive1 15
	Weapon.AmmoUse2 0
	Weapon.AmmoGive2 1
	Weapon.AmmoType1 "BoltAmmo"
	Weapon.AmmoType2 "BallistaAmmo"
	Inventory.PickupMessage "Ballista (Slot 4)"
    Inventory.PickupSound "weapons/ballista/drawstring"
	Obituary "%k Speared %o with a Ballista"
    AttackSound "None"
	Weapon.BobStyle InverseSmooth
    +WEAPON.NOALERT
    +WEAPON.NOAUTOAIM
	+WEAPON.NOAUTOFIRE
	+FORCEXYBILLBOARD
	Scale 0.7
	Tag "Ballista"
		States {	
/////FLASHES//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
			FlashPunching:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashPunchingObject")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "FlashPunchingUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "FlashPunchingBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "FlashPunchingExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "FlashPunchingDemonic")
			FlashPunchingBolt:
				CB_D ABCDEEEEEEDCBA 1
				stop
			FlashPunchingExplosive:
				CB_D FGHIJJJJJJIHGF 1
				stop
			FlashPunchingDemonic:
				CB_D KLMNOOOOOONMLK 1
				stop
			FlashPunchingUnloaded:
				CB_D PQRSTTTTTTSRQP 1
				stop
			FlashKicking:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashKickingObject")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "FlashKickingUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "FlashKickingBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "FlashKickingExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "FlashKickingDemonic")
			FlashKickingBolt:
				CB_C ABCDEEEEEEDCBA 1
				stop
			FlashKickingExplosive:
				CB_C FGHIJJJJJJIHGF 1
				stop
			FlashKickingDemonic:
				CB_C KLMNOOOOOONMLK 1
				stop
			FlashKickingUnloaded:
				CB_C PQRSTTTTTTSRQP 1
				stop
			FlashAirKicking:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashAirKickingObject")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "FlashAirKickingUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "FlashAirKickingBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "FlashAirKickingExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "FlashAirKickingDemonic")
			FlashAirKickingBolt:
				CB_C ABCDEEEEEEEDCBA 1
				stop
			FlashAirKickingExplosive:
				CB_C FGHIJJJJJJJIHGF 1
				stop
			FlashAirKickingDemonic:
				CB_C KLMNOOOOOOONMLK 1
				stop
			FlashAirKickingUnloaded:
				CB_C PQRSTTTTTTTSRQP 1
				stop
			FlashSlideKicking:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashSlideKickingObject")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "FlashSlideKickingUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "FlashSlideKickingBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "FlashSlideKickingExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "FlashSlideKickingDemonic")
				Goto FlashSlideKickingBolt
			FlashSlideKickingBolt:
				CB_C ABCD 1
				CB_C E 21
				Goto FlashSlideKickingStop
			FlashSlideKickingExplosive:
				CB_C FGHI 1
				CB_C J 21
				Goto FlashSlideKickingStop
			FlashSlideKickingDemonic:
				CB_C KLMN 1
				CB_C O 21
				Goto FlashSlideKickingStop
			FlashSlideKickingUnloaded:
				CB_C PQRS 1
				CB_C T 21
				Goto FlashSlideKickingStop
			FlashSlideKickingStop:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "FlashSlideKickingStopObject")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "FlashSlideKickingStopUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "FlashSlideKickingStopBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "FlashSlideKickingStopExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "FlashSlideKickingStopDemonic")
				Goto FlashSlideKickingBolt
			FlashSlideKickingStopBolt:
				CB_C EEEDCBA 1
				Stop
			FlashSlideKickingStopExplosive:
				CB_C JJJIHGF 1
				Stop
			FlashSlideKickingStopDemonic:
				CB_C OOONMLK 1
				Stop
			FlashSlideKickingStopUnloaded:
				CB_C TTTSRQP 1
				Stop
/////STATES//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
			Spawn:
				CB_Z A -1
				Stop
			
			Select:
				TNT1 A 0 A_SetCrosshair(29)
				TNT1 A 0 {
					A_WeaponOffset(0,32);
					A_SetRoll(0);
					A_TakeInventory("PB_LockScreenTilt",1);
					A_ClearOverlays(10,11);	}
				Goto SelectFirstPersonLegs
			SelectContinue:
				TNT1 A 0 A_Takeinventory("Unloading",1)
				TNT1 A 0 A_Takeinventory("RandomHeadExploder",1)
				TNT1 A 0 A_Takeinventory("HitboxFireDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxIceDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxAcidDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxPlasmaDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxDemonicDamage",1)
				TNT1 A 0 A_Takeinventory("HitboxBladedDamage",1)
				TNT1 A 0 A_TakeInventory("BlasterPistolSelected",1)
				TNT1 A 0 A_TakeInventory("TacticalPistolSelected",1)
				TNT1 A 0 A_TakeInventory("MagnumSelected",1)
				TNT1 A 0 A_TakeInventory("DesertEagleSelected",1)
				TNT1 A 0 A_TakeInventory("PumpShotgunSelected",1)
				TNT1 A 0 A_TakeInventory("SlugShotgunSelected",1)
				TNT1 A 0 A_TakeInventory("LeverActionSelected",1)
				TNT1 A 0 A_TakeInventory("DoubleBarrelShotgunSelected",1)
				TNT1 A 0 A_TakeInventory("QuadBarrelShotgunSelected",1)
				TNT1 A 0 A_TakeInventory("SubMachineGunSelected",1)
				TNT1 A 0 A_TakeInventory("MP40Selected",1)
				TNT1 A 0 A_TakeInventory("AssaultRifleSelected",1)
				TNT1 A 0 A_TakeInventory("LightMachineGunSelected",1)
				TNT1 A 0 A_TakeInventory("SniperSelected",1)
				TNT1 A 0 A_TakeInventory("DMRSelected",1)
				TNT1 A 0 A_TakeInventory("MiniGunSelected",1)
				TNT1 A 0 A_TakeInventory("NailgunSelected",1)
				TNT1 A 0 A_TakeInventory("MG42Selected",1)
				TNT1 A 0 A_TakeInventory("ThumperSelected",1)
				TNT1 A 0 A_TakeInventory("GuidedRocketLauncherSelected",1)
				TNT1 A 0 A_TakeInventory("ExcavatorSelected",1)
				TNT1 A 0 A_TakeInventory("M1PlasmaRifleSelected",1)
				TNT1 A 0 A_TakeInventory("M2PlasmaRifleSelected",1)
				TNT1 A 0 A_TakeInventory("CryoRifleSelected",1)
				TNT1 A 0 A_TakeInventory("FlamerSelected",1)
				TNT1 A 0 A_TakeInventory("RailGunSelected",1)
				TNT1 A 0 A_TakeInventory("BigFuckingGunSelected",1)
				TNT1 A 0 A_GiveInventory("BallistaSelected",1)
				TNT1 A 0 A_TakeInventory("DemonicRifleSelected",1)
				TNT1 A 0 A_TakeInventory("FrostburnDeviceSelected",1)
				TNT1 A 0 A_TakeInventory("HasFlare",1)
				TNT1 A 0 A_TakeInventory("HasQuickLauncher",1)
				TNT1 A 0 A_TakeInventory("HasBarrel",1)
				TNT1 A 0 A_TakeInventory("HasIceBarrel", 1)
				TNT1 A 0 A_TakeInventory("HasFlameBarrel",1)
				TNT1 A 0 A_TakeInventory("EquippedObject",1)
				TNT1 A 0 A_TakeInventory("RifleWasEmpty",1)
				TNT1 A 0 {
					if( CountInv ("RadSuitOn") >= 1 ) {
						A_overlay(800,"WearingRadSuit",false);
						A_overlayflags(800, PSPF_ADDBOB, false);
						A_overlayflags(800, PSPF_ALPHA | PSPF_RENDERSTYLE, true);
						A_OverlayRenderstyle(800,STYLE_Translucent);
						A_overlayalpha(800,0.8);
					}
				}
				TNT1 AAAAAAAAAAAAAAAAAA 0 A_Raise
				TNT1 AAAAAAAA 1 A_Raise
				Wait
			SelectAnimation:
				TNT1 A 0
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "SelectAnimationUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "SelectAnimationBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "SelectAnimationExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "SelectAnimationDemonic")
			SelectAnimationBolt:
				CB_A ABCDE 1
				Goto Ready3
			SelectAnimationExplosive:
				CB_A STUVW 1
				Goto Ready3
			SelectAnimationDemonic:
				CB_A LMNOR 1
				Goto Ready3
			SelectAnimationUnloaded:
				CB_A GHIJK 1
				Goto Ready3	
			
			Ready:
				TNT1 A 0 A_JumpIfInventory("RespectBallista", 1, "SelectAnimation")
			WeaponRespect:
				TNT1 A 1
				TNT1 A 0 A_GiveInventory("RespectBallista",1)
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 A_JumpIfInventory("BallistaAmmo", 1, 1)
				Goto RespectEmpty
				TNT1 A 0 A_JumpIfInventory("SwapToDemonicMode", 1, "ContinueRespectDemonic")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "ContinueRespectBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "ContinueRespectExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "ContinueRespectDemonic")
				Goto ContinueRespectBolt
			ContinueRespectBolt:
				TNT1 A 0 {
					A_PlaySoundEx("Ironsights","Auto");
					A_GiveInventory("BallistaBoltMode",1);
					A_TakeInventory("BallistaExplosiveMode",1);
					A_TakeInventory("BallistaDemonicMode",1);
					A_TakeInventory("SwapToDemonicMode",1);
					A_TakeInventory("BallistaUnloaded",1);
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_D TSRQP 1 A_DoPBWeaponAction
				CB_A K 5 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_E ABCDEF 1 {
					A_SetRoll(roll-.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_E GGGGGGGGG 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				CB_E HIJKKKKKKK 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/drawstring","Auto")
				CB_E LMNOP 1 A_DoPBWeaponAction
				CB_F AB 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltin","Auto")
				CB_F CDE 1 A_DoPBWeaponAction
				CB_F FFFFF 1 A_DoPBWeaponAction
				CB_F FG 1 {
					A_SetRoll(roll-.3, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_F HHHHH 1 A_DoPBWeaponAction
				CB_F H 1 {
					A_SetRoll(roll+.3, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_F IJ 1 {
					A_SetRoll(roll+.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_F KLMN 1 {
					A_SetRoll(roll+.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				Goto Ready3
			ContinueRespectExplosive:
				TNT1 A 0 {
					A_PlaySoundEx("Ironsights","Auto");
					A_TakeInventory("BallistaBoltMode",1);
					A_GiveInventory("BallistaExplosiveMode",1);
					A_TakeInventory("BallistaDemonicMode",1);
					A_TakeInventory("SwapToDemonicMode",1);
					A_TakeInventory("BallistaUnloaded",1);
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_D TSRQP 1 A_DoPBWeaponAction
				CB_A K 5 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_E ABCDEF 1 {
					A_SetRoll(roll-.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_E GGGGGGGGG 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				CB_E HIJKKKKKKK 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/drawstring","Auto")
				CB_E LMNOP 1 A_DoPBWeaponAction
				CB_G AB 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltin","Auto")
				CB_G CDE 1 A_DoPBWeaponAction
				CB_G FFFFF 1 A_DoPBWeaponAction
				CB_G FG 1 {
					A_SetRoll(roll-.3, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_G HHHHH 1 A_DoPBWeaponAction
				CB_G H 1 {
					A_SetRoll(roll+.3, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_G IJ 1 {
					A_SetRoll(roll+.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_G KLMN 1 {
					A_SetRoll(roll+.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				Goto Ready3
			ContinueRespectDemonic:
				TNT1 A 0 {
					A_PlaySoundEx("weapons/ballista/boltinoutdemonic","Auto");
					A_TakeInventory("BallistaBoltMode",1);
					A_TakeInventory("BallistaExplosiveMode",1);
					A_GiveInventory("BallistaDemonicMode",1);
					A_TakeInventory("SwapToDemonicMode",1);
					A_TakeInventory("BallistaUnloaded",1);
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_D TSRQP 1 A_DoPBWeaponAction
				CB_A K 5 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_E ABCDEF 1 {
					A_SetRoll(roll-.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_E GGGGGGGGG 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				CB_E HIJKKKKKKK 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/drawstring","Auto")
				CB_E LMNOP 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltinoutdemonic","Auto")
				CB_H ABC 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_H DEF 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_H GG 1
				CB_H GG 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_H HIJK 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				Goto Ready3
			RespectEmpty:
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_D TSRQP 1 A_DoPBWeaponAction
				CB_A K 5 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_E ABCDEF 1 {
					A_SetRoll(roll-.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_E GGGGGGGGG 1 A_DoPBWeaponAction
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				TNT1 A 0 {
					A_PlaySoundEx("Ironsights","Auto");
					A_GiveInventory("BallistaUnloaded",1);
				}
				CB_E FED 1 {
					A_SetRoll(roll+.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_E CB 1 {
					A_SetRoll(roll+.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_E A 1 {
					A_SetRoll(roll+.4, SPF_INTERPOLATE);
					A_DoPBWeaponAction;
				}
				CB_A KKK 1 A_DoPBWeaponAction
				Goto Ready3
				
			Ready3:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 A_SetCrosshair(29)
				TNT1 A 0 {
					A_SetRoll(0);
					A_SetInventory("Zoomed",0);
					A_SetInventory("ADSMode",0);
					A_TakeInventory("PB_LockScreenTilt",1);
					}
			ReadyToFire:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "ReadyEmpty")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "ReadyToFireBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "ReadyToFireExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "ReadyToFireDemonic")
				Goto ReadyToFireBolt
			ReadyToFireBolt:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 A_JumpIfInventory("SwapToDemonicMode", 1, "WeaponSpecial")
				CB_A E 1 {				
					if (PressingFire() && PressingAltfire() && CountInv("BallistaAmmo") > 0){
							return state("Fire");
					}
					if (PressingFire() && CountInv("BallistaAmmo") > 0){
							return state("Fire");
					}
					return A_DoPBWeaponAction(WRF_ALLOWRELOAD);	
				}
				Loop
			ReadyToFireExplosive:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 A_JumpIfInventory("SwapToDemonicMode", 1, "WeaponSpecial")
				CB_A WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWXYZYX 1 {				
					if (PressingFire() && PressingAltfire() && CountInv("BallistaAmmo") > 0){
							return state("Fire");
					}
					if (PressingFire() && CountInv("BallistaAmmo") > 0){
							return state("Fire");
					}
					return A_DoPBWeaponAction(WRF_ALLOWRELOAD);	
				}
				Loop
			ReadyToFireDemonic:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				CB_A PPPQQQRRRQQQ 1 {				
					if (PressingFire() && PressingAltfire() && CountInv("BallistaAmmo") > 0){
							return state("Fire");
					}
					if (PressingFire() && CountInv("BallistaAmmo") > 0){
							return state("Fire");
					}
					if (PressingAltFire()){
							return state("AltFire");
					}
					return A_DoPBWeaponAction(WRF_ALLOWRELOAD);	
				}
				Loop
			ReadyEmpty:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				CB_A K 1 A_DoPBWeaponAction
				TNT1 A 0 A_GiveInventory("BallistaUnloaded",1)
				Loop
				
			Ready2:
				TNT1 A 0 A_SetCrosshair(5)
				TNT1 A 0 {
					A_SetRoll(0);
					A_ZoomFactor(1.5);
					A_SetInventory("Zoomed",1);
					A_SetInventory("ADSMode",1);
					A_TakeInventory("PB_LockScreenTilt",1);
					}
			ReadyToFire2:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "Ready2Empty")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "Ready2Bolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "Ready2Explosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "Ready2Demonic")
				Goto Ready2Bolt
			Ready2Bolt:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 A_JumpIfInventory("SwapToDemonicMode", 1, "WeaponSpecial")
				CB_L E 1 {
					if(GetCvar("pb_toggle_aim_hold")) {
						if(!PressingAltfire() || JustReleased(BT_ALTATTACK)){
							return state("Zoomout");
						}
						if (PressingFire() && PressingAltfire() && CountInv("BallistaAmmo") > 0){
								return state("Fire2");
						}
						return A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOSECONDARY);
					}
					else {
						if (PressingFire() && CountInv("BallistaAmmo") > 0 ){
							return state("Fire2");
						}
						return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
					}
					return state("");
				}
				Loop
			Ready2Explosive:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 A_JumpIfInventory("SwapToDemonicMode", 1, "WeaponSpecial")
				CB_L OOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOOPQRQP 1 {
					if(GetCvar("pb_toggle_aim_hold")) {
						if(!PressingAltfire() || JustReleased(BT_ALTATTACK)){
							return state("Zoomout");
						}
						if (PressingFire() && PressingAltfire() && CountInv("BallistaAmmo") > 0){
								return state("Fire2");
						}
						return A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOSECONDARY);
					}
					else {
						if (PressingFire() && CountInv("BallistaAmmo") > 0 ){
							return state("Fire2");
						}
						return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
					}
					return state("");
				}
				Loop
			Ready2Demonic:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				CB_L WXYX 3 {
					if(GetCvar("pb_toggle_aim_hold")) {
						if(!PressingAltfire() || JustReleased(BT_ALTATTACK)){
							return state("Zoomout");
						}
						if (PressingFire() && PressingAltfire() && CountInv("BallistaAmmo") > 0){
								return state("Fire2");
						}
						return A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOSECONDARY);
					}
					else {
						if (PressingFire() && CountInv("BallistaAmmo") > 0 ){
							return state("Fire2");
						}
						return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
					}
					return state("");
				}
				Loop
			Ready2Empty:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "ReadyObject")
				TNT1 A 0 { 
					if (CountInv("SwapToDemonicMode") >= 1){ return state("ReloadDemonic");}
					return state ("");
				}
				TNT1 A 0 { 
					if (CountInv("BoltAmmo") >= 1){ return state("Reload");}
					return state ("");
				}
				TNT1 A 0 { 
					if (CountInv("ExplosiveAmmo") >= 1){ return state("Reload");}
					return state ("");
				}
				TNT1 A 0 { 
					if (CountInv("HellAmmo") >= 5 && CountInv("BallistaUpgraded") == 1){ return state("Reload");}
					return state ("");
				}
				CB_L J 1 {
					A_GiveInventory("BallistaUnloaded",1);
					if(GetCvar("pb_toggle_aim_hold")) {
						if(!PressingAltfire() || JustReleased(BT_ALTATTACK)){
							return state("Zoomout");
						}
						if (PressingFire() && PressingAltfire() && CountInv("BallistaAmmo") > 0){
								return state("Fire2");
						}
						return A_DoPBWeaponAction(WRF_ALLOWRELOAD|WRF_NOSECONDARY);
					}
					else {
						if (PressingFire() && CountInv("BallistaAmmo") > 0 ){
							return state("Fire2");
						}
						return A_DoPBWeaponAction(WRF_ALLOWRELOAD);
					}
					return state("");
				}
				Loop
				
			Deselect:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "DeselectObject")
				TNT1 A 0 A_SetCrosshair(5)
				TNT1 A 0 {
					A_WeaponOffset(0,32);
					A_SetRoll(0);
					A_TakeInventory("PB_LockScreenTilt",1);
					A_TakeInventory("Reloading",1);
					A_TakeInventory("Zoomed",1);
					A_TakeInventory("ADSMode",1);
					A_ClearOverlays(10,11);
					A_ZoomFactor(1.0); 
				}	
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "DeselectUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "DeselectBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "DeselectExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "DeselectDemonic")
			DeselectBolt:
				CB_A EDCBA 1
				Goto FinishDeselect
			DeselectExplosive:
				CB_A WVUTS 1
				Goto FinishDeselect
			DeselectDemonic:
				CB_A PONML 1
				Goto FinishDeselect
			DeselectUnloaded:
				CB_A KJIHG 1
				Goto FinishDeselect
			FinishDeselect:
				TNT1 AAAAAAAAAAAAAAAAAA 0 A_Lower
				Wait
				
			Fire:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "PrimaryFireObject")
				TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Fire2")
				TNT1 A 0 A_JumpIfInventory("BallistaAmmo",1,1)
				Goto Reload
				TNT1 A 0 {
					A_SetInventory("Zoomed",0);
					A_SetInventory("ADSMode",0);
					A_TakeInventory("BallistaAmmo",1);
					A_GiveInventory("BallistaUnloaded",1);
					A_ZoomFactor(0.98);
				}
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "FireBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "FireExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "FireDemonic")
			FireBolt:
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/firebolt","Auto")
				TNT1 A 0 A_FireCustomMissile("BallistaBolt", 0, 0, 0, -1, 0, 0)
				CB_B A 1 
				CB_B B 1 
				CB_B C 0 A_SetPitch(-1.5 + pitch)
				CB_B C 0 A_ZoomFactor(1.00)
				CB_B C 1 A_SetPitch(+1.0 + pitch)
				CB_B CC 1 A_SetPitch(+1.0 + pitch)
				CB_B C 1 A_SetPitch(+0.5 + pitch)
				CB_B C 2 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
				Goto Reload
			FireExplosive:
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/firebolt","Auto")
				TNT1 A 0 A_FireCustomMissile("ExplosiveBolt", 0, 0, 0, -1, 0, 0)
				CB_B A 1 
				CB_B B 1 
				CB_B C 0 A_SetPitch(-1.5 + pitch)
				CB_B C 0 A_ZoomFactor(1.00)
				CB_B C 1 A_SetPitch(+1.0 + pitch)
				CB_B CC 1 A_SetPitch(+1.0 + pitch)
				CB_B C 1 A_SetPitch(+0.5 + pitch)
				CB_B C 2 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
				Goto Reload
			FireDemonic:
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/firedemonic","Auto")
				TNT1 A 0 A_FireCustomMissile("DemonicBolt", 0, 0, 0, -1, 0, 0)
				CB_B D 1 BRIGHT 
				CB_B B 1 BRIGHT
				CB_B C 0 A_SetPitch(-3.5 + pitch)
				CB_B C 0 A_ZoomFactor(1.00)
				CB_B C 1 A_SetPitch(+1.0 + pitch)
				CB_B CC 1 A_SetPitch(+1.0 + pitch)
				CB_B C 1 A_SetPitch(+0.5 + pitch)
				CB_B C 2 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
				Goto Reload
				
			Fire2:
				TNT1 A 0 A_JumpIfInventory("BallistaAmmo",1,1)
				Goto Reload
				TNT1 A 0 {
					A_SetInventory("Zoomed",1);
					A_SetInventory("ADSMode",1);
					A_TakeInventory("BallistaAmmo",1);
					A_GiveInventory("BallistaUnloaded",1);
					A_ZoomFactor(1.48);
				}
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "Fire2Bolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "Fire2Explosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "Fire2Demonic")
			Fire2Bolt:
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/firebolt","Auto")
				TNT1 A 0 A_FireCustomMissile("BallistaBolt", 0, 0, 0, -1, 0, 0)
				CB_M A 1 
				CB_M B 1 
				CB_M C 0 A_SetPitch(-1.2 + pitch)
				CB_M C 0 A_ZoomFactor(1.5)
				CB_M C 1 A_SetPitch(+0.7 + pitch)
				CB_M CC 1 A_SetPitch(+0.7 + pitch)
				CB_M C 1 A_SetPitch(+0.2 + pitch)
				CB_M C 2 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
				Goto Reload
			Fire2Explosive:
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/firebolt","Auto")
				TNT1 A 0 A_FireCustomMissile("ExplosiveBolt", 0, 0, 0, -1, 0, 0)
				CB_M A 1 
				CB_M B 1 
				CB_M C 0 A_SetPitch(-1.2 + pitch)
				CB_M C 0 A_ZoomFactor(1.5)
				CB_M C 1 A_SetPitch(+0.7 + pitch)
				CB_M CC 1 A_SetPitch(+0.7 + pitch)
				CB_M C 1 A_SetPitch(+0.2 + pitch)
				CB_M C 2 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
				Goto Reload
			Fire2Demonic:
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/firedemonic","Auto")
				TNT1 A 0 A_FireCustomMissile("DemonicBolt", 0, 0, 0, -1, 0, 0)
				CB_M D 1 BRIGHT 
				CB_M B 1 BRIGHT
				CB_M C 0 A_SetPitch(-1.2 + pitch)
				CB_M C 0 A_ZoomFactor(1.5)
				CB_M C 1 A_SetPitch(+0.7 + pitch)
				CB_M CC 1 A_SetPitch(+0.7 + pitch)
				CB_M C 1 A_SetPitch(+0.2 + pitch)
				CB_M C 2 A_WeaponReady(WRF_NOFIRE| WRF_NOBOB)//Allows quick switch
				Goto Reload
				
			WeaponSpecial:
				"####" "#" 0 A_JumpIfInventory ("EquippedObject", 1, "WeaponSpecialObject")
				TNT1 A 0 A_Takeinventory("GoWeaponSpecialAbility",1)
				TNT1 A 0 {
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("BoltAmmo") == 0 && CountInv("HellAmmo") < 5){ return state("CantModeSwap");}
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("BoltAmmo") == 0 && CountInv("HellAmmo") > 5 && CountInv("BallistaUpgraded") == 0){ return state("CantModeSwap");}
					return state ("");
					}
				TNT1 A 0 {
					A_GiveInventory("PB_LockScreenTilt",1);
					A_ZoomFactor(1.0);
					A_ClearOverlays(10,11);
				}
				TNT1 A 0 A_JumpIfInventory ("BallistaBoltMode",1,"UnloadBolt")
				TNT1 A 0 A_JumpIfInventory ("BallistaExplosiveMode",1,"UnloadExplosiveBolt")
				TNT1 A 0 A_JumpIfInventory ("BallistaDemonicMode",1,"UnloadDemonicBolt")
			UnloadBolt:
				TNT1 A 0 { 
					if (CountInv("HellAmmo") < 5 && CountInv("ExplosiveAmmo") == 0){ return state("CantModeSwap");}
					if (CountInv("HellAmmo") > 5 && CountInv("ExplosiveAmmo") == 0 && CountInv("BallistaUpgraded") == 0){ return state("CantModeSwap");}
					return state ("");
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_F NMLKJI 1 A_SetRoll(roll-.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltout","Auto")
				TNT1 A 0 {
					A_GiveInventory("BoltAmmo",1);
					A_TakeInventory("BallistaAmmo",1);
				}
				CB_F H 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_F G 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_F F 1
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				CB_F EDCBA 1
				CB_E P 1 {
					A_SetInventory("BallistaBoltMode",0);
				}
				TNT1 A 0 { 
					if (CountInv("SwapToDemonicMode") == 1){ return state("LoadDemonicBolt");}
					if (CountInv("ExplosiveAmmo") == 0){ return state("LoadDemonicBolt");}
					return state ("");
				}
				Goto LoadExplosiveBolt
			UnloadExplosiveBolt:
				TNT1 A 0 { 
					if (CountInv("HellAmmo") < 5 && CountInv("BoltAmmo") == 0){ return state("CantModeSwap");}
					return state ("");
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_G NMLKJI 1 A_SetRoll(roll-.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltout","Auto")
				TNT1 A 0 {
					A_GiveInventory("ExplosiveAmmo",1);
					A_TakeInventory("BallistaAmmo",1);
				}
				CB_G H 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_G G 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_G F 1
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				CB_G EDCBA 1
				CB_E P 1 {
					A_SetInventory("BallistaExplosiveMode",0);
				}
				TNT1 A 0 { 
					if (CountInv("BallistaUpgraded") == 0){ return state("LoadBolt");}
					return state ("");
				}
				TNT1 A 0 { 
					if (CountInv("SwapToDemonicMode") == 1){ return state("LoadDemonicBolt");}
					if (CountInv("HellAmmo") < 5){ return state("LoadBolt");}
					return state ("");
				}
				Goto LoadDemonicBolt
			UnloadDemonicBolt:
				TNT1 A 0 { 
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("BoltAmmo") == 0){ return state("CantModeSwap");}
					return state ("");
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_H KJIHG 1 A_SetRoll(roll-.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltinoutdemonic","Auto")
				TNT1 A 0 {
					A_GiveInventory("HellAmmo",5);
					A_TakeInventory("BallistaAmmo",1);
				}
				CB_H F 1 A_SetRoll(roll-.4, SPF_INTERPOLATE)
				CB_H EDCBA 1
				CB_E P 1 {
					A_SetInventory("BallistaDemonicMode",0);
				}
				TNT1 A 0 { 
					if (CountInv("BoltAmmo") < 1){ return state("LoadExplosiveBolt");}
					return state ("");
				}
				Goto LoadBolt
			LoadBolt:
				CB_E P 4 {
					A_SetInventory("BallistaBoltMode",1);
				}
				CB_F AB 1
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltin","Auto")
				TNT1 A 0 {
					A_TakeInventory("BoltAmmo",1);
					A_GiveInventory("BallistaAmmo",1);
					A_TakeInventory("BallistaUnloaded",1);
					A_TakeInventory("SwapToDemonicMode",1);
				}
				CB_F CDE 1
				CB_F FG 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_F H 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_F IJ 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_F KLMN 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				Goto Ready3
			LoadExplosiveBolt:
				CB_E P 4 {
					A_SetInventory("BallistaExplosiveMode",1);
				}
				CB_G AB 1
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltin","Auto")
				TNT1 A 0 {
					A_TakeInventory("ExplosiveAmmo",1);
					A_GiveInventory("BallistaAmmo",1);
					A_TakeInventory("BallistaUnloaded",1);
					A_TakeInventory("SwapToDemonicMode",1);
				}
				CB_G CDE 1
				CB_G FG 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_G H 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_G IJ 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_G KLMN 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				Goto Ready3
			LoadDemonicBolt:
				CB_E P 4 {
					A_SetInventory("BallistaDemonicMode",1);
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltinoutdemonic","Auto")
				TNT1 A 0 {
					A_TakeInventory("HellAmmo",5);
					A_GiveInventory("BallistaAmmo",1);
					A_TakeInventory("BallistaUnloaded",1);
					A_TakeInventory("SwapToDemonicMode",1);
				}
				CB_H ABC 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_H DEF 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_H GG 1
				CB_H GG 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_H HIJK 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				Goto Ready3
			CantModeSwap:
				TNT1 A 0 A_Print("No Alternate Ammo")
				TNT1 A 0 A_JumpIfInventory("Zoomed",1,"Ready2")
				Goto Ready3
			
			AltFire:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "AltFireObject")
				TNT1 A 0 {
					A_SetRoll(0);
					A_SetCrosshair(29);
					A_TakeInventory("PB_LockScreenTilt",1);
					A_ClearOverlays(10,11);
				}
				TNT1 A 0 A_StartSound("IronSights", 0)
				TNT1 A 0 A_JumpIfInventory("Zoomed",1,"ZoomOut")
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "ZoomInUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "ZoomInBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "ZoomInExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "ZoomInDemonic")
			ZoomInBolt:
				TNT1 A 0 A_ZoomFactor(1.5)
				CB_L ABCD 1
				TNT1 A 0 {
				A_Giveinventory("Zoomed",1);
				A_Giveinventory("ADSmode",1);
				A_SetCrosshair(5);
				A_WeaponReady(WRF_NOSECONDARY);
				if (CountInv("BallistaAmmo") == 0){ return state("Reload");}
					return state ("");
				}
				Goto ReadyToFire2
			ZoomInExplosive:
				TNT1 A 0 A_ZoomFactor(1.5)
				CB_L KLMN 1
				TNT1 A 0 {
				A_Giveinventory("Zoomed",1);
				A_Giveinventory("ADSmode",1);
				A_SetCrosshair(5);
				A_WeaponReady(WRF_NOSECONDARY);
				if (CountInv("BallistaAmmo") == 0){ return state("Reload");}
					return state ("");
				}
				Goto ReadyToFire2
			ZoomInDemonic:
				TNT1 A 0 A_ZoomFactor(1.5)
				CB_L STUV 1
				TNT1 A 0 {
				A_Giveinventory("Zoomed",1);
				A_Giveinventory("ADSmode",1);
				A_SetCrosshair(5);
				A_WeaponReady(WRF_NOSECONDARY);
				if (CountInv("BallistaAmmo") == 0){ return state("Reload");}
					return state ("");
				}
				Goto ReadyToFire2
			ZoomInUnloaded:
				TNT1 A 0 A_ZoomFactor(1.5)
				CB_L FGHI 1
				TNT1 A 0 {
				A_Giveinventory("Zoomed",1);
				A_Giveinventory("ADSmode",1);
				A_SetCrosshair(5);
				A_WeaponReady(WRF_NOSECONDARY);
				if (CountInv("BallistaAmmo") == 0){ return state("Reload");}
					return state ("");
				}
				Goto ReadyToFire2
			ZoomOut:
				TNT1 A 0 A_JumpIfInventory("BallistaUnloaded", 1, "ZoomOutUnloaded")
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "ZoomOutBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "ZoomOutExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "ZoomOutDemonic")
			ZoomOutBolt:
				TNT1 A 0 {	
					A_SetCrosshair(29);
					A_ZoomFactor(1.0);
					}
				CB_L DCBA 1
				TNT1 A 0 {	
					A_Takeinventory("Zoomed",1);
					A_Takeinventory("ADSmode",1);
					if (CountInv("BallistaAmmo") == 0){ return state("Reload");}
					return state ("");
					}
				TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
				Goto Ready3
			ZoomOutExplosive:
				TNT1 A 0 {	
					A_SetCrosshair(29);
					A_ZoomFactor(1.0);
					}
				CB_L NMLK 1
				TNT1 A 0 {	
					A_Takeinventory("Zoomed",1);
					A_Takeinventory("ADSmode",1);
					if (CountInv("BallistaAmmo") == 0){ return state("Reload");}
					return state ("");
					}
				TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
				Goto Ready3
			ZoomOutDemonic:
				TNT1 A 0 {	
					A_SetCrosshair(29);
					A_ZoomFactor(1.0);
					}
				CB_L VUTS 1
				TNT1 A 0 {	
					A_Takeinventory("Zoomed",1);
					A_Takeinventory("ADSmode",1);
					if (CountInv("BallistaAmmo") == 0){ return state("Reload");}
					return state ("");
					}
				TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
				Goto Ready3
			ZoomOutUnloaded:
				TNT1 A 0 {	
					A_SetCrosshair(29);
					A_ZoomFactor(1.0);
					}
				CB_L IHGF 1
				TNT1 A 0 {	
					A_Takeinventory("Zoomed",1);
					A_Takeinventory("ADSmode",1);
					if (CountInv("BallistaAmmo") == 0){ return state("Reload");}
					return state ("");
					}
				TNT1 A 0 A_WeaponReady(WRF_NOSECONDARY)
				Goto Ready3
				
		   Reload:
				TNT1 A 0 A_JumpIfInventory ("EquippedObject", 1, "ReloadObject")
				TNT1 A 0 A_JumpIfInventory ("BallistaAmmo", 1, "Ready3")
				TNT1 A 0 {
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("BoltAmmo") == 0 && CountInv("HellAmmo") < 5 && CountInv("Zoomed") == 0){ return state("ReadyEmpty");}
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("BoltAmmo") == 0 && CountInv("HellAmmo") < 5 && CountInv("Zoomed") == 1){ return state("Ready2Empty");}
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("BoltAmmo") == 0 && CountInv("HellAmmo") > 5 && CountInv("BallistaUpgraded") == 0 && CountInv("Zoomed") == 0){ return state("ReadyEmpty");}
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("BoltAmmo") == 0 && CountInv("HellAmmo") > 5 && CountInv("BallistaUpgraded") == 0 && CountInv("Zoomed") == 1){ return state("Ready2Empty");}
					return state ("");
					}
				TNT1 A 0 {
					A_SetCrosshair(5);
					A_ZoomFactor(1.0);
					A_Giveinventory("PB_LockScreenTilt",1);
					}
				TNT1 A 0 A_JumpIfInventory("Zoomed", 1, "Zoomout")
				TNT1 A 0 {
					A_Takeinventory("Zoomed",1);
					A_Takeinventory("ADSmode",1);
				}
				TNT1 A 0 A_JumpIfInventory("BallistaBoltMode", 1, "ReloadBolt")
				TNT1 A 0 A_JumpIfInventory("BallistaExplosiveMode", 1, "ReloadExplosive")
				TNT1 A 0 A_JumpIfInventory("BallistaDemonicMode", 1, "ReloadDemonic")
			ReloadBolt:
				TNT1 A 0 { 
					if (CountInv("BoltAmmo") == 0 && CountInv("ExplosiveAmmo") >= 1){ return state("ReloadExplosive");}
					return state ("");
				}
				TNT1 A 0 { 
					if (CountInv("BoltAmmo") == 0 && CountInv("HellAmmo") >= 5 && CountInv("BallistaUpgraded") == 1 ){ return state("ReloadDemonic");}
					return state ("");
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_E ABCDEF 1 A_SetRoll(roll-.4, SPF_INTERPOLATE)
				CB_E GGGGGGGGG 1 
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				CB_E HIJKKKKKKK 1
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/drawstring","Auto")
				CB_E LMNOPPPPP 1
				TNT1 A 0
				TNT1 A 0 {
					A_SetInventory("BallistaBoltMode",1);
					A_SetInventory("BallistaExplosiveMode",0);
					A_SetInventory("BallistaDemonicMode",0);
					A_SetInventory("BallistaUnloaded",0);
					A_TakeInventory("SwapToDemonicMode",1);
					A_SetInventory("BallistaAmmo",1);
					A_TakeInventory("BoltAmmo",1);
					A_PlaySoundEx("Ironsights","Auto");
					}
				CB_F AB 1
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltin","Auto")
				CB_F CDE 1
				CB_F FG 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_F H 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_F IJ 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_F KLMN 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				Goto Ready3
			ReloadExplosive:
				TNT1 A 0 { 
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("HellAmmo") >= 5 && CountInv("BallistaUpgraded") == 1){ return state("ReloadDemonic");}
					return state ("");
				}
				TNT1 A 0 { 
					if (CountInv("ExplosiveAmmo") == 0 && CountInv("BoltAmmo") >= 1){ return state("ReloadBolt");}
					return state ("");
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_E ABCDEF 1 A_SetRoll(roll-.4, SPF_INTERPOLATE)
				CB_E GGGGGGGGG 1 
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				CB_E HIJKKKKKKK 1
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/drawstring","Auto")
				CB_E LMNOPPPPP 1
				TNT1 A 0
				TNT1 A 0 {
					A_SetInventory("BallistaBoltMode",0);
					A_SetInventory("BallistaExplosiveMode",1);
					A_SetInventory("BallistaDemonicMode",0);
					A_SetInventory("BallistaUnloaded",0);
					A_TakeInventory("SwapToDemonicMode",1);
					A_SetInventory("BallistaAmmo",1);
					A_TakeInventory("ExplosiveAmmo",1);
					A_PlaySoundEx("Ironsights","Auto");
					}
				CB_G AB 1
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/boltin","Auto")
				CB_G CDE 1
				CB_G FG 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_G H 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_G IJ 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_G KLMN 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				Goto Ready3
			ReloadDemonic:
				TNT1 A 0 A_JumpIfInventory("BallistaUpgraded",1,1)
				Goto Ready3
				TNT1 A 0 { 
					if (CountInv("HellAmmo") < 5 && CountInv("BoltAmmo") >= 1){ return state("ReloadBolt");}
					return state ("");
				}
				TNT1 A 0 { 
					if (CountInv("HellAmmo") < 5 && CountInv("ExplosiveAmmo") >= 1){ return state("ReloadExplosive");}
					return state ("");
				}
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_E ABCDEF 1 A_SetRoll(roll-.4, SPF_INTERPOLATE)
				CB_E GGGGGGGGG 1 
				TNT1 A 0 A_PlaySoundEx("Ironsights","Auto")
				CB_E HIJKKKKKKKKKK 1
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/drawstring","Auto")
				CB_E LMNOPPPPP 1
				TNT1 A 0
				TNT1 A 0 {
					A_SetInventory("BallistaBoltMode",0);
					A_SetInventory("BallistaExplosiveMode",0);
					A_SetInventory("BallistaDemonicMode",1);
					A_SetInventory("BallistaUnloaded",0);
					A_TakeInventory("SwapToDemonicMode",1);
					A_SetInventory("BallistaAmmo",1);
					A_TakeInventory("HellAmmo",5);
					A_PlaySoundEx("weapons/ballista/boltinoutdemonic","Auto");
					}
				CB_H ABC 1 A_SetRoll(roll+.3, SPF_INTERPOLATE)
				CB_H DEF 1 A_SetRoll(roll-.3, SPF_INTERPOLATE)
				CB_H GG 1
				CB_H GG 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				TNT1 A 0 A_PlaySoundEx("weapons/ballista/raise","Auto")
				CB_H HIJK 1 A_SetRoll(roll+.4, SPF_INTERPOLATE)
				Goto Ready3
			Steady:
				TNT1 A 1
				Goto Ready
			Unload:
				TNT1 A 0 A_TakeInventory("Unloading", 1)
				Goto Ready3	}}

/////OTHERS//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Actor DemonicBallista: PB_UpgradeItem {
	Game Doom
	Scale 0.7
	Inventory.Pickupsound "weapons/ballista/drawstring"
	Inventory.PickupMessage "Demonic Ballista Upgrade (Slot 4)"
	+INVENTORY.ALWAYSPICKUP
	+COUNTITEM
		States {
			Spawn:
				CB_Z B 10 
				LOOP
			Pickup:
				TNT1 A 0 {
					if (CountInv("BallistaUpgraded") == 0) {
						A_GiveInventory("SwapToDemonicMode", 1);
					}
				}
				TNT1 A 0 A_GiveInventory("Ballista", 1)
				TNT1 A 0 A_GiveInventory("BallistaUpgraded", 1)
				TNT1 A 0 A_GiveInventory("HellAmmo", 60)
				Stop	}}
				
ACTOR BallistaAmmo: Ammo {
   Inventory.Amount 0
   Inventory.MaxAmount 1
   Ammo.BackpackAmount 0
   Ammo.BackpackMaxAmount 1
   +INVENTORY.IGNORESKILL
   Inventory.Icon "DEGTA0"	}

ACTOR BallistaBolt: FastProjectile {
	Radius 2
	Height 2
	Projectile
	Speed 150
    Damage (150)
	Scale 1.0
    Decal Scorch
	Damagetype "Nailgun"
	Projectile
	+MISSILE
    +NOGRAVITY
    +BLOODSPLATTER 
	+THRUSPECIES
	+MTHRUSPECIES
	SeeSound ""
	DeathSound "Weapons/NailHit"
	Obituary "$OB_MPROCKET"
	Species "Marines"
		States {
			Spawn:
				CB_Z C 1 A_PlaySound("Weapons/NailFlight", CHAN_BODY,1.0,True)
			Fly:
				CB_Z C 2 A_SpawnItemEx("BoltTrail", 0, 0, 0, 1, 0, 0, 180, 128)
				Loop
			Death:
			Crash:
				TNT1 A 0 A_StopSound(CHAN_BODY)
				TNT1 A 0 A_PlaySoundEx("Weapons/NailHit","Auto")
				TNT1 A 0 A_SpawnItem("HitPuff")
				TNT1 A 0 A_Stop
				CB_Z C 1 A_SpawnItemEx ("BoltPickup",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
				Stop
			XDeath:
				TNT1 A 0 A_StopSound(CHAN_BODY)
				CB_Z C 0 A_PlaySound("Weapons/NailHitBleed")
				Stop	}}
				
ACTOR ExplosiveBolt: BallistaBolt {
	Damage 0
	Damagetype "Explosive"
	+DONTBOUNCEONSHOOTABLES
	+USEBOUNCESTATE
	+HITTRACER
	var int user_stickycounter;
	var int user_stuckEnemy;
		States {
			Fly:
				CB_Z D 2 A_SpawnItemEx("BoltTrail", 0, 0, 0, 1, 0, 0, 180, 128)
				Loop
			Death:
			Crash:
				TNT1 A 0 {
					user_stickycounter = 0;
					A_NoGravity;
					A_ScaleVelocity(0);
				}
			Stuck:
				CB_Z DDDDDDD 1  {
					//A_Fire(22);
					if(user_stuckEnemy == 1) {

						if(AAPTR_TRACER) {
							A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION);
						}
						else {
							A_Fall;
						}
					}
					return state("");
				}
				TNT1 A 0 {
					A_SpawnItem("GreenFlareSmall",0,0);
					A_PlaySound("BEP", 4);
					user_stickycounter++;
				}
				TNT1 A 0 A_JumpIf(user_stickycounter < 4, "Stuck")
				TNT1 A 0 A_PlaySoundEx("RA1IF1","Auto")
				CB_Z DDDDD 1
				TNT1 A 0 {
					A_SpawnItem("GreenFlareSmall",0,0);
					A_PlaySound("BEP", 4);
					A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION);
				}
				CB_Z DDDD 1
				TNT1 A 0 {
					A_SpawnItem("GreenFlareSmall",0,0);
					A_PlaySound("BEP", 4);
					A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION);
				}
				CB_Z DD 1
				TNT1 A 0 {
					A_SpawnItem("GreenFlareSmall",0,0);
					A_PlaySound("BEP", 4);
					A_Warp(AAPTR_TRACER,0,0,20,0,WARPF_NOCHECKPOSITION);
				}
				TNT1 A 0 A_JumpIf(user_stickycounter > 4, "Detonate")
				Loop
			XDeath:
			Bounce.Creature:
				CB_Z D 1 {
					A_Changeflag("THRUACTORS", 1);
					A_Changeflag("Solid", 1);
					user_stuckEnemy = 1;
					A_Stop;
				}
				CB_Z D 1 {
					A_Changeflag("THRUACTORS", 0);
					A_Changeflag("Solid", 0);
				}
				Goto Stuck
			Detonate:
				TNT1 A 0 A_StopSound
				TNT1 A 0 A_PlaySound("Explosion",4)
				TNT1 A 0 A_Explode(250,150)
				TNT1 AAA 0 A_CustomMissile ("ExplosionSmoke", 22, 0, random (0, 360), 2, random (0, 360))
				TNT1 A 0 A_SpawnItemEx ("ExplosionFlareSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
				TNT1 A 0 A_SpawnItemEx ("DetectFloorCraterSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
				TNT1 A 0 A_SpawnItemEx ("DetectCeilCraterSmall",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION,0)
				TNT1 A 0 A_SpawnItemEx ("StickyExplosion",0,0,-2,0,0,0,0,SXF_NOCHECKPOSITION,0)
				TNT1 A 0 A_SpawnItemEx ("NewRocketExploFX", 0, 0, 0)
				TNT1 AAAAA 0 A_CustomMissile ("ExplosionParticleVeryFast", 0, 0, random (0, 360), 2, random (0, 360))
				XXXX A 0 A_CustomMissile ("ExplosionQuake", 1, 0, random (0, 360), 2, random (0, 160))
				TNT1 AAAAA 0 A_CustomMissile ("MediumExplosionFlames", 0, 0, random (0, 360), 2, random (0, 360))
				TNT1 A 0 A_PlaySound("FAREXPL",3)
				EXPL AA 0 A_CustomMissile ("ExplosionSmoke", 0, 0, random (0, 360), 2, random (0, 360))  
				Stop	}}

