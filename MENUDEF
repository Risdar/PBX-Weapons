AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBXWeapons_Settings", "PBXWeapons_Menu"
}

AddOptionMenu "PBXCore_Menu"
{
    StaticText	"--------- PBX Weapons Settings ---------", 1
    Option "Enable Weapon Tooltips", "pbxweapons_sendTip", "OnOff","PBXCore_SendTip"
    SafeCommand "Enable All PBX Spawners", "set PBXWeapons_chainsaw_filter 0; set PBXWeapons_pistol_filter 0; set PBXWeapons_shotgun_filter 0; set PBXWeapons_ssg_filter 0; set PBXWeapons_chaingun_filter 0; set PBXWeapons_rocketlauncher_filter 0; set PBXWeapons_plasmarifle_filter 0; set PBXWeapons_bfg_filter 0;set pbxweapons_backpack_filter 0"
    SafeCommand "Reset PB Tool Tips", "set pb_helpflags 0"
    SafeCommand "Reset PBX Weapons Tool Tips", "set PBXWeapons_WeaponHelpFlags 0; set PBXWeapons_UpgradeHelpFlags 0"
    StaticText "$PBXWeapons_Version",red
    StaticText " "
}

OptionMenu "PBXWeapons_Menu"
{
    Title "$PBXWeapons_Settings"
	Class "PB_OptionMenu"
    Position	-48

    StaticText	"--------- General Settings ---------", 1
    Option "Enable Weapon Tooltips", "pbxweapons_sendTip", "OnOff","PBXCore_SendTip"
    Option "Start with the BDP Rifle", "pbxweapons_normalriflereplace", "OnOff"
    Option "Start with the Pistol Blaster", "pbxweapons_startwithblaster", "OnOff"
    StaticText " "
    SafeCommand "Enable All PBX Spawners", "set PBXWeapons_chainsaw_filter 0; set PBXWeapons_pistol_filter 0; set PBXWeapons_shotgun_filter 0; set PBXWeapons_ssg_filter 0; set PBXWeapons_chaingun_filter 0; set PBXWeapons_rocketlauncher_filter 0; set PBXWeapons_plasmarifle_filter 0; set PBXWeapons_bfg_filter 0;set pbxweapons_backpack_filter 0"
    SafeCommand "Reset PB Tool Tips", "set pb_helpflags 0"
    SafeCommand "Reset PBX Weapons Tool Tips", "set PBXWeapons_WeaponHelpFlags 0; set PBXWeapons_UpgradeHelpFlags 0"
	/* Option "Enable Experimental Features",	"pbxweapons_experimental",	"YesNo" */    
    StaticText " "

    StaticText "$PBXWeapons_Version",red
}


