AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBX_Settings", "PBX_HudMenu"
}
OptionMenu "PBX_HudMenu"
{
    Title "$PBX_Settings"

    StaticText "PBX Settings"
    FlagOption "Weapon Smoke",            "pbx_generalsetting_filter",    "OffOn", 0

    StaticText " "

    StaticText "HUD Settings"
    StaticText "Weapon Position"
    FlagOption "Weapon HUD",            "pbx_hudsetting_filter",    "OffOn", 0
    Slider     "Horizontal (X)",        "pbx_Weaponhud_x",          -700, 700, 1
    Slider     "Vertical (Y)",          "pbx_Weaponhud_y",          -700, 700, 1
    Slider     "Scale",                 "pbx_Weaponhud_scale",      0.1, 10, 0.1
    Slider     "Transparency",	        "pbx_Weaponhud_alpha",      0, 1, 0.02, 2
    
    StaticText " "

    StaticText "Weapon Mode Position"
    FlagOption "Weapon Mode HUD",       "pbx_hudsetting_filter",    "OffOn", 1
    Slider     "Horizontal (X)",        "pbx_WeaponModehud_x",      -700, 700, 1
    Slider     "Vertical (Y)",          "pbx_WeaponModehud_y",      -700, 700, 1
    Slider     "Scale",                 "pbx_WeaponModehud_scale",  0.1, 10, 0.1
    Slider     "Transparency",	        "pbx_WeaponModehud_alpha",  0, 1, 0.02, 2

    /* StaticText "Visuals"
    Slider "HUD Opacity", "pbx_hud_alpha", 0.0, 1.0, 0.1 */
    StaticText " "
    
    // Reset
    Command "Reset HUD to Default", "set pbx_Weaponhud_x -100.0; set pbx_Weaponhud_y -90.0; set pbx_Weaponhud_scale 1.0; set pbx_WeaponModehud_x -260; set pbx_WeaponModehud_y -14; pbx_WeaponModehud_scale 2.5; set pbx_WeaponModehud_alpha 1.0; set pbx_Weaponhud_alpha 1.0"
}


